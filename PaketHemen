            let kuryeHtml = '';
            kuryeler.forEach(k => {
                const bakimSayisi = bakimKayitlari.filter(b => b.kuryeId === k.id).length;
                const geriBildirimSayisi = geriBildirimler.filter(g => g.kuryeId === k.id).length;
                kuryeHtml += `
                    <div class="flex justify-between items-center p-3 bg-brand-lightYellow/30 rounded-lg">
                        <div>
                            <span class="font-bold text-brand-dark">${k.isim}</span>
                            ${k.telefon ? `<span class="text-sm text-gray-500 ml-2">📞 ${k.telefon}</span>` : ''}
                        </div>
                        <div>
                            <span class="px-3 py-1 bg-brand-orange text-white rounded-full text-sm font-bold mr-2">${bakimSayisi} bakım</span>
                            <span class="px-3 py-1 bg-brand-green text-white rounded-full text-sm font-bold">${geriBildirimSayisi} bildirim</span>
                        </div>
                    </div>
                `;
            });
            document.getElementById('rapor-kurye-listesi').innerHTML = kuryeHtml || '<p class="text-gray-500">Kurye yok</p>';

            const sonGeriBildirimler = [...geriBildirimler].sort((a,b) => new Date(b.tarih) - new Date(a.tarih)).slice(0, 5);
            document.getElementById('rapor-geri-bildirimler').innerHTML = sonGeriBildirimler.map(g => {
                let durumText = '✓ Normal';
                if (g.sorunSayisi > 0) durumText = `⚠️ ${g.sorunSayisi} sorun`;
                else if (g.yeniParcaSayisi > 0) durumText = `🔄 ${g.yeniParcaSayisi} yeni`;
                
                return `
                    <div class="flex justify-between items-center p-2 bg-gray-50 rounded text-sm">
                        <span class="font-bold ${g.sorunSayisi > 0 ? 'text-red-500' : (g.yeniParcaSayisi > 0 ? 'text-brand-blue' : 'text-green-500')}">
                            ${g.plaka} - ${durumText}
                        </span>
                        <span class="text-gray-600">${g.kuryeIsim}</span>
                        <span class="text-gray-500">${new Date(g.tarih).toLocaleDateString('tr-TR')}</span>
                    </div>
                `;
            }).join('') || '<p class="text-gray-500">Geri bildirim yok</p>';

            const sonBakimlar = [...bakimKayitlari].sort((a,b) => new Date(b.tarih) - new Date(a.tarih)).slice(0, 5);
            document.getElementById('rapor-son-bakimlar').innerHTML = sonBakimlar.map(b => `
                <div class="flex justify-between items-center p-2 bg-gray-50 rounded text-sm">
                    <span class="font-bold ${b.tip === 'yag' ? 'text-brand-yellow' : 'text-brand-orange'}">
                        ${b.tip === 'yag' ? '🛢️' : '🔧'} ${b.plaka}
                    </span>
                    <span class="text-gray-600">${b.kuryeIsim}</span>
                    <span class="text-gray-500">${new Date(b.tarih).toLocaleDateString('tr-TR')}</span>
                </div>
            `).join('') || '<p class="text-gray-500">Bakım kaydı yok</p>';
        }

        function printReport() {
            window.print();
        }

        function openModal(type) {
            if (type === 'kurye-ekle') {
                document.getElementById('kurye-modal-title').textContent = 'Yeni Kurye Ekle';
                document.getElementById('kurye-id').value = '';
                document.getElementById('kurye-modal-isim').value = '';
                document.getElementById('kurye-modal-telefon').value = '';
                document.getElementById('kurye-modal-plaka').value = '';
                document.getElementById('modal-kurye').classList.add('active');
            } else if (type === 'motor-ekle') {
                document.getElementById('motor-modal-title').textContent = 'Yeni Motor Ekle';
                document.getElementById('motor-id').value = '';
                document.getElementById('motor-modal-plaka').value = '';
                document.getElementById('motor-modal-model').value = '';
                document.getElementById('motor-modal-yil').value = new Date().getFullYear();
                document.getElementById('modal-motor').classList.add('active');
            }
        }

        function closeModal(type) {
            document.getElementById(`modal-${type}`).classList.remove('active');
        }

        function saveKurye() {
            const id = document.getElementById('kurye-id').value;
            const isim = document.getElementById('kurye-modal-isim').value.trim();
            const telefon = document.getElementById('kurye-modal-telefon').value.trim();
            const plaka = document.getElementById('kurye-modal-plaka').value.trim().toUpperCase();

            if (!isim || !plaka) {
                alert('İsim ve plaka zorunludur!');
                return;
            }

            let motor = motorlar.find(m => m.plaka === plaka);
            if (!motor) {
                motor = {
                    id: Date.now(),
                    plaka: plaka,
                    model: 'Bilinmiyor',
                    yil: new Date().getFullYear(),
                    km: 0
                };
                motorlar.push(motor);
            }

            if (id) {
                const k = kuryeler.find(x => x.id == id);
                if (k) {
                    k.isim = isim;
                    k.telefon = telefon;
                    k.plaka = plaka;
                }
            } else {
                kuryeler.push({
                    id: Date.now(),
                    isim: isim,
                    telefon: telefon,
                    plaka: plaka,
                    durum: 'aktif',
                    ilkGiris: new Date().toISOString()
                });
            }

            saveData();
            closeModal('kurye');
            renderKuryeList();
            generateReport();
        }

        function editKurye(id) {
            const k = kuryeler.find(x => x.id === id);
            if (!k) return;
            document.getElementById('kurye-modal-title').textContent = 'Kurye Düzenle';
            document.getElementById('kurye-id').value = k.id;
            document.getElementById('kurye-modal-isim').value = k.isim;
            document.getElementById('kurye-modal-telefon').value = k.telefon || '';
            document.getElementById('kurye-modal-plaka').value = k.plaka;
            document.getElementById('modal-kurye').classList.add('active');
        }

        function deleteKurye(id) {
            if (!confirm('Silmek istediğinize emin misiniz?')) return;
            kuryeler = kuryeler.filter(k => k.id !== id);
            saveData();
            renderKuryeList();
            generateReport();
        }

        function saveMotor() {
            const id = document.getElementById('motor-id').value;
            const plaka = document.getElementById('motor-modal-plaka').value.trim().toUpperCase();
            const model = document.getElementById('motor-modal-model').value.trim();
            const yil = parseInt(document.getElementById('motor-modal-yil').value) || new Date().getFullYear();

            if (!plaka || !model) {
                alert('Plaka ve model zorunludur!');
                return;
            }

            if (id) {
                const m = motorlar.find(x => x.id == id);
                if (m) {
                    m.plaka = plaka;
                    m.model = model;
                    m.yil = yil;
                }
            } else {
                motorlar.push({
                    id: Date.now(),
                    plaka: plaka,
                    model: model,
                    yil: yil,
                    km: 0
                });
            }

            saveData();
            closeModal('motor');
            renderMotorList();
            generateReport();
        }

        function editMotor(id) {
            const m = motorlar.find(x => x.id === id);
            if (!m) return;
            document.getElementById('motor-modal-title').textContent = 'Motor Düzenle';
            document.getElementById('motor-id').value = m.id;
            document.getElementById('motor-modal-plaka').value = m.plaka;
            document.getElementById('motor-modal-model').value = m.model;
            document.getElementById('motor-modal-yil').value = m.yil;
            document.getElementById('modal-motor').classList.add('active');
        }

        function deleteMotor(id) {
            if (!confirm('Bu motoru silmek istediğinize emin misiniz? Bağlı tüm kayıtlar da silinecek!')) return;
            
            const m = motorlar.find(x => x.id === id);
            if (m) {
                bakimKayitlari = bakimKayitlari.filter(b => b.plaka !== m.plaka);
                geriBildirimler = geriBildirimler.filter(g => g.plaka !== m.plaka);
                kuryeler.forEach(k => { if (k.plaka === m.plaka) k.plaka = ''; });
                saveData();
            }
            motorlar = motorlar.filter(x => x.id !== id);
            saveData();
            renderMotorList();
            renderKuryeList();
            renderBakimKayitlari();
            renderGeriBildirimler();
            generateReport();
        }

        document.addEventListener('DOMContentLoaded', loadData);
        
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('active'); });
        });
    </script>
</body>
</html>

