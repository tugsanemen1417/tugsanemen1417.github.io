<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🛵 MotoTakip Pro - Kurye & Filo Yönetimi</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Nunito', 'sans-serif'] },
                    colors: {
                        brand: {
                            yellow: '#FFD93D', orange: '#FF6B35', pink: '#FF006E',
                            purple: '#8338EC', blue: '#3A86FF', green: '#06FFA5', 
                            dark: '#1a1a2e', red: '#ef4444'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body { font-family: 'Nunito', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); border: 2px solid rgba(255, 255, 255, 0.2); }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
        .login-bg { background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab); background-size: 400% 400%; animation: gradient 15s ease infinite; }
        @keyframes gradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
        #map-kurye, #map-admin { height: 400px; border-radius: 1rem; }
        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center; }
        .modal.active { display: flex; }
        .modal-content { background: white; border-radius: 1rem; padding: 2rem; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; }
        .timeline-item { position: relative; padding-left: 2rem; border-left: 2px solid #e5e7eb; margin-left: 0.5rem; }
        .timeline-item::before { content: ''; position: absolute; left: -0.375rem; top: 0.5rem; width: 0.75rem; height: 0.75rem; border-radius: 50%; background: #8338EC; }
        .timeline-item.success::before { background: #06FFA5; }
        .timeline-item.warning::before { background: #FFD93D; }
    </style>
</head>
<body class="bg-gray-100">

    <!-- LOGIN SCREEN -->
    <div id="login-screen" class="fixed inset-0 z-50 login-bg flex items-center justify-center p-4">
        <div class="max-w-4xl w-full grid md:grid-cols-2 gap-8">
            <div class="glass rounded-3xl p-8 text-white cursor-pointer hover:scale-105 transition-transform" onclick="showKuryeLogin()">
                <div class="text-center">
                    <div class="text-6xl mb-4 animate-bounce">🛵</div>
                    <h2 class="text-3xl font-bold mb-2">Kurye Girişi</h2>
                    <div id="kurye-form" class="hidden space-y-4 text-left mt-6">
                        <input type="text" id="kurye-isim" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/30 text-white placeholder-white/60" placeholder="İsim Soyisim">
                        <input type="text" id="kurye-plaka" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/30 text-white placeholder-white/60 uppercase" placeholder="Plaka (örn: 34 ABC 123)">
                        <button onclick="loginKurye()" class="w-full py-3 bg-brand-yellow text-brand-dark font-bold rounded-xl hover:bg-white transition-all">Giriş Yap</button>
                    </div>
                    <button id="kurye-btn" class="mt-4 px-8 py-3 bg-white/20 rounded-full font-bold">Giriş Yap <i class="fas fa-arrow-right ml-2"></i></button>
                </div>
            </div>

            <div class="glass rounded-3xl p-8 text-white cursor-pointer hover:scale-105 transition-transform" onclick="showAdminLogin()">
                <div class="text-center">
                    <div class="text-6xl mb-4 animate-bounce" style="animation-delay: 0.5s">👨‍💼</div>
                    <h2 class="text-3xl font-bold mb-2">Yönetici Girişi</h2>
                    <div id="admin-form" class="hidden space-y-4 text-left mt-6">
                        <input type="text" id="admin-user" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/30 text-white placeholder-white/60" placeholder="Kullanıcı adı">
                        <input type="password" id="admin-pass" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/30 text-white placeholder-white/60" placeholder="Şifre">
                        <button onclick="loginAdmin()" class="w-full py-3 bg-brand-pink text-white font-bold rounded-xl hover:bg-white hover:text-brand-pink transition-all">Giriş Yap</button>
                    </div>
                    <button id="admin-btn" class="mt-4 px-8 py-3 bg-white/20 rounded-full font-bold">Giriş Yap <i class="fas fa-arrow-right ml-2"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- KURYE PANEL -->
    <div id="kurye-panel" class="hidden min-h-screen bg-gradient-to-br from-brand-blue to-brand-purple">
        <header class="bg-white/10 backdrop-blur-md text-white p-4 sticky top-0 z-40">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <div class="flex items-center space-x-3">
                    <span class="text-3xl">🛵</span>
                    <div>
                        <h1 class="font-bold text-lg">MotoTakip</h1>
                        <p class="text-xs opacity-80" id="kurye-plaka-display">-</p>
                    </div>
                </div>
                <button onclick="logout()" class="p-2 bg-red-500 rounded-lg hover:bg-red-600"><i class="fas fa-sign-out-alt"></i></button>
            </div>
        </header>

        <div class="max-w-7xl mx-auto p-4 space-y-4">
            <!-- Durum Kartı -->
            <div class="bg-white rounded-2xl p-6 shadow-xl">
                <h2 class="text-xl font-bold text-gray-800 mb-4">🚀 Durum Güncelle</h2>
                <div class="grid grid-cols-2 gap-4">
                    <button onclick="updateKuryeDurum('müsait')" class="p-4 bg-green-100 rounded-xl text-green-700 font-bold hover:bg-green-200">✅ Müsait</button>
                    <button onclick="updateKuryeDurum('dagitim')" class="p-4 bg-blue-100 rounded-xl text-blue-700 font-bold hover:bg-blue-200">📦 Dağıtımda</button>
                    <button onclick="updateKuryeDurum('mola')" class="p-4 bg-yellow-100 rounded-xl text-yellow-700 font-bold hover:bg-yellow-200">☕ Mola</button>
                    <button onclick="updateKuryeDurum('servis')" class="p-4 bg-red-100 rounded-xl text-red-700 font-bold hover:bg-red-200">🔧 Servis</button>
                </div>
                <div id="current-durum" class="mt-4 text-center font-bold text-lg"></div>
            </div>

            <!-- Motor Bilgisi ve Bakım Geçmişi -->
            <div class="bg-white rounded-2xl p-6 shadow-xl">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold text-gray-800">🏍️ Motor Bilgisi</h2>
                    <button onclick="showMotorHistoryKurye()" class="px-4 py-2 bg-brand-purple text-white rounded-lg text-sm hover:bg-purple-600">
                        <i class="fas fa-history mr-2"></i>Bakım Geçmişi
                    </button>
                </div>
                <div id="kurye-motor-info" class="space-y-3">
                    <p class="text-gray-500 text-center">Motor bilgisi yükleniyor...</p>
                </div>
            </div>

            <!-- Bakım Yap Butonu -->
            <div class="bg-white rounded-2xl p-6 shadow-xl">
                <h2 class="text-xl font-bold text-gray-800 mb-4">🔧 Bakım İşlemi</h2>
                <p class="text-gray-600 mb-4 text-sm">Bakım yaptırdıktan sonra km bilgisini girin:</p>
                <div class="flex space-x-3">
                    <input type="number" id="bakim-km-input" class="flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-brand-blue outline-none" placeholder="Örn: 12500">
                    <button onclick="bakimYaptir()" class="px-6 py-3 bg-brand-green text-white font-bold rounded-xl hover:bg-green-600 transition-all">
                        <i class="fas fa-wrench mr-2"></i>Bakım Kaydet
                    </button>
                </div>
                <p class="text-xs text-gray-500 mt-2">* Bu kayıt motorun geçmişine eklenecek ve sonraki kuryeler görebilecek</p>
            </div>

            <!-- Harita -->
            <div class="bg-white rounded-2xl p-4 shadow-xl">
                <h2 class="text-xl font-bold text-gray-800 mb-4">📍 Konumum</h2>
                <div id="map-kurye"></div>
            </div>
        </div>
    </div>

    <!-- YÖNETİCİ PANEL -->
    <div id="admin-panel" class="hidden min-h-screen bg-gray-100">
        <aside class="fixed left-0 top-0 h-full w-64 bg-brand-dark text-white p-6 z-40 transform -translate-x-full md:translate-x-0 transition-transform" id="sidebar">
            <div class="mb-8">
                <h1 class="text-2xl font-bold">🛵 MotoTakip Pro</h1>
                <p class="text-xs text-gray-400 mt-1">Yönetim Paneli</p>
            </div>
            <nav class="space-y-2">
                <button onclick="showSection('dashboard')" class="w-full text-left px-4 py-3 rounded-xl bg-brand-purple/20 text-brand-purple border-l-4 border-brand-purple">
                    <i class="fas fa-chart-line mr-3"></i> Dashboard
                </button>
                <button onclick="showSection('kuryeler')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10">
                    <i class="fas fa-users mr-3"></i> Kuryeler
                </button>
                <button onclick="showSection('motors')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10">
                    <i class="fas fa-motorcycle mr-3"></i> Motorlar
                </button>
                <button onclick="showSection('bakim')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10">
                    <i class="fas fa-tools mr-3"></i> Bakım Kayıtları
                </button>
            </nav>
            <button onclick="logout()" class="absolute bottom-6 left-6 right-6 py-3 bg-red-500 rounded-xl font-bold">
                <i class="fas fa-sign-out-alt mr-2"></i> Çıkış
            </button>
        </aside>

        <main class="md:ml-64 p-4 md:p-8">
            <div class="flex justify-between items-center mb-8">
                <button onclick="toggleSidebar()" class="md:hidden p-2 bg-white rounded-lg"><i class="fas fa-bars"></i></button>
                <h2 class="text-2xl font-bold text-gray-800" id="page-title">📊 Dashboard</h2>
                <div class="flex items-center space-x-4">
                    <div class="bg-white px-4 py-2 rounded-lg shadow flex items-center space-x-2">
                        <div class="w-8 h-8 bg-brand-purple rounded-full flex items-center justify-center text-white font-bold">A</div>
                        <span class="font-bold text-sm hidden sm:block">Admin</span>
                    </div>
                </div>
            </div>

            <!-- Dashboard -->
            <div id="section-dashboard" class="space-y-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-brand-green">
                        <p class="text-gray-500 text-sm">Aktif Kurye</p>
                        <p class="text-3xl font-bold" id="stat-kurye">0</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-brand-blue">
                        <p class="text-gray-500 text-sm">Toplam Motor</p>
                        <p class="text-3xl font-bold" id="stat-motor">0</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-brand-orange">
                        <p class="text-gray-500 text-sm">Bakım Bekleyen</p>
                        <p class="text-3xl font-bold" id="stat-bakim">0</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-brand-pink">
                        <p class="text-gray-500 text-sm">Toplam Bakım</p>
                        <p class="text-3xl font-bold" id="stat-bakim-sayisi">0</p>
                    </div>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-lg">
                    <h3 class="font-bold text-lg mb-4">🗺️ Canlı Harita</h3>
                    <div id="map-admin"></div>
                </div>
            </div>

            <!-- Kuryeler -->
            <div id="section-kuryeler" class="hidden space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="text-xl font-bold">👥 Kurye Yönetimi</h3>
                    <button onclick="openModal('kurye-ekle')" class="px-4 py-2 bg-brand-purple text-white rounded-lg hover:bg-purple-600">
                        <i class="fas fa-plus mr-2"></i>Yeni Kurye
                    </button>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" id="kurye-list"></div>
            </div>

            <!-- Motorlar -->
            <div id="section-motors" class="hidden space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="text-xl font-bold">🏍️ Motor Yönetimi</h3>
                    <button onclick="openModal('motor-ekle')" class="px-4 py-2 bg-brand-blue text-white rounded-lg hover:bg-blue-600">
                        <i class="fas fa-plus mr-2"></i>Yeni Motor
                    </button>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" id="motor-list"></div>
            </div>

            <!-- Bakım Kayıtları -->
            <div id="section-bakim" class="hidden space-y-6">
                <h3 class="text-xl font-bold">🔧 Tüm Bakım Kayıtları</h3>
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-bold text-gray-500">Tarih</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-gray-500">Plaka</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-gray-500">Model</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-gray-500">Bakım KM</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-gray-500">Yapan Kurye</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-gray-500">Sonraki Bakım</th>
                            </tr>
                        </thead>
                        <tbody id="bakim-kayitlari-table" class="divide-y divide-gray-100"></tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- MODALLER -->
    
    <!-- Kurye Ekle/Düzenle -->
    <div id="modal-kurye" class="modal">
        <div class="modal-content">
            <h3 class="text-xl font-bold mb-4" id="kurye-modal-title">Yeni Kurye Ekle</h3>
            <input type="hidden" id="kurye-id">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold mb-1">İsim Soyisim</label>
                    <input type="text" id="kurye-modal-isim" class="w-full px-4 py-2 border rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-1">Telefon</label>
                    <input type="text" id="kurye-modal-telefon" class="w-full px-4 py-2 border rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-1">Atanacak Motor (Plaka)</label>
                    <select id="kurye-modal-motor" class="w-full px-4 py-2 border rounded-lg">
                        <option value="">Motor Seç...</option>
                    </select>
                </div>
            </div>
            <div class="flex space-x-3 mt-6">
                <button onclick="saveKurye()" class="flex-1 py-2 bg-brand-green text-white font-bold rounded-lg">Kaydet</button>
                <button onclick="closeModal('kurye')" class="flex-1 py-2 bg-gray-200 text-gray-700 font-bold rounded-lg">İptal</button>
            </div>
        </div>
    </div>

    <!-- Motor Ekle/Düzenle -->
    <div id="modal-motor" class="modal">
        <div class="modal-content">
            <h3 class="text-xl font-bold mb-4" id="motor-modal-title">Yeni Motor Ekle</h3>
            <input type="hidden" id="motor-id">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold mb-1">Plaka</label>
                    <input type="text" id="motor-modal-plaka" class="w-full px-4 py-2 border rounded-lg uppercase">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-1">Model</label>
                    <input type="text" id="motor-modal-model" class="w-full px-4 py-2 border rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-1">Yıl</label>
                    <input type="number" id="motor-modal-yil" class="w-full px-4 py-2 border rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-1">Mevcut KM</label>
                    <input type="number" id="motor-modal-km" class="w-full px-4 py-2 border rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-1">Bakım Aralığı (KM)</label>
                    <input type="number" id="motor-modal-bakim-araligi" value="1000" class="w-full px-4 py-2 border rounded-lg">
                </div>
            </div>
            <div class="flex space-x-3 mt-6">
                <button onclick="saveMotor()" class="flex-1 py-2 bg-brand-blue text-white font-bold rounded-lg">Kaydet</button>
                <button onclick="closeModal('motor')" class="flex-1 py-2 bg-gray-200 text-gray-700 font-bold rounded-lg">İptal</button>
            </div>
        </div>
    </div>

    <!-- Motor Geçmişi Modal (Kurye için) -->
    <div id="modal-motor-gecmisi" class="modal">
        <div class="modal-content max-w-2xl">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-bold">📋 Motor Bakım Geçmişi</h3>
                <button onclick="closeModal('motor-gecmisi')" class="text-gray-500 hover:text-gray-700">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            <div id="motor-gecmisi-icerik" class="space-y-4 max-h-96 overflow-y-auto">
                <!-- Dinamik içerik -->
            </div>
        </div>
    </div>

    <!-- Motor Detay Modal (Admin için) -->
    <div id="modal-motor-detay" class="modal">
        <div class="modal-content max-w-2xl">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-bold" id="detay-plaka">Motor Detayı</h3>
                <button onclick="closeModal('motor-detay')" class="text-gray-500 hover:text-gray-700">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="bg-gray-50 p-4 rounded-xl">
                    <p class="text-sm text-gray-500">Model</p>
                    <p class="font-bold text-lg" id="detay-model">-</p>
                </div>
                <div class="bg-gray-50 p-4 rounded-xl">
                    <p class="text-sm text-gray-500">Yıl</p>
                    <p class="font-bold text-lg" id="detay-yil">-</p>
                </div>
                <div class="bg-gray-50 p-4 rounded-xl">
                    <p class="text-sm text-gray-500">Mevcut KM</p>
                    <p class="font-bold text-lg text-brand-blue" id="detay-km">-</p>
                </div>
                <div class="bg-gray-50 p-4 rounded-xl">
                    <p class="text-sm text-gray-500">Sonraki Bakım</p>
                    <p class="font-bold text-lg text-brand-orange" id="detay-sonraki">-</p>
                </div>
            </div>

            <h4 class="font-bold mb-4 flex items-center">
                <i class="fas fa-history mr-2 text-brand-purple"></i>
                Bakım Geçmişi
            </h4>
            <div id="detay-gecmis" class="space-y-3 max-h-64 overflow-y-auto">
                <!-- Dinamik içerik -->
            </div>
        </div>
    </div>

    <script>
        // ========== VERİ YÖNETİMİ ==========
        
        let kuryeler = [];
        let motorlar = [];
        let bakimKayitlari = []; // Yeni: Bakım geçmişi
        let currentUser = null;
        let currentRole = null;

        function loadData() {
            const savedKuryeler = localStorage.getItem('mototakip_kuryeler');
            const savedMotorlar = localStorage.getItem('mototakip_motorlar');
            const savedBakimlar = localStorage.getItem('mototakip_bakimlar');
            
            if (savedKuryeler) kuryeler = JSON.parse(savedKuryeler);
            if (savedMotorlar) motorlar = JSON.parse(savedMotorlar);
            if (savedBakimlar) bakimKayitlari = JSON.parse(savedBakimlar);
            
            updateStats();
        }

        function saveData() {
            localStorage.setItem('mototakip_kuryeler', JSON.stringify(kuryeler));
            localStorage.setItem('mototakip_motorlar', JSON.stringify(motorlar));
            localStorage.setItem('mototakip_bakimlar', JSON.stringify(bakimKayitlari));
            updateStats();
        }

        // ========== GİRİŞ SİSTEMİ ==========

        function showKuryeLogin() {
            document.getElementById('kurye-form').classList.remove('hidden');
            document.getElementById('kurye-btn').classList.add('hidden');
            document.getElementById('admin-form').classList.add('hidden');
            document.getElementById('admin-btn').classList.remove('hidden');
        }

        function showAdminLogin() {
            document.getElementById('admin-form').classList.remove('hidden');
            document.getElementById('admin-btn').classList.add('hidden');
            document.getElementById('kurye-form').classList.add('hidden');
            document.getElementById('kurye-btn').classList.remove('hidden');
        }

        function loginKurye() {
            const isim = document.getElementById('kurye-isim').value.trim();
            const plaka = document.getElementById('kurye-plaka').value.trim().toUpperCase();

            if (!isim || !plaka) {
                alert('Lütfen tüm alanları doldurun!');
                return;
            }

            const motor = motorlar.find(m => m.plaka === plaka);
            if (!motor) {
                alert('Bu plakaya kayıtlı motor bulunamadı! Yöneticinize başvurun.');
                return;
            }

            let kurye = kuryeler.find(k => k.isim === isim && k.plaka === plaka);
            if (!kurye) {
                kurye = {
                    id: Date.now(),
                    isim: isim,
                    plaka: plaka,
                    telefon: '',
                    durum: 'müsait',
                    tarih: new Date().toISOString()
                };
                kuryeler.push(kurye);
                saveData();
            }

            currentUser = kurye;
            currentRole = 'kurye';
            
            document.getElementById('login-screen').classList.add('hidden');
            document.getElementById('kurye-panel').classList.remove('hidden');
            document.getElementById('kurye-plaka-display').textContent = plaka;
            
            updateKuryeDisplay();
