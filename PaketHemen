    <div class="mobile-nav-item" onclick="showPageMobile('health', this)"><span>❤️</span><span>Sağlık</span></div>
    <div class="mobile-nav-item" onclick="showPageMobile('km', this)"><span>📍</span><span>KM Gir</span></div>
    <div class="mobile-nav-item" onclick="showPageMobile('admin', this)"><span>⚙️</span><span>Yönetici</span></div>
    <div class="mobile-nav-item" onclick="showPageMobile('profile', this)"><span>👤</span><span>Profil</span></div>
  </div>
</div>

<script>
  // Date
  const d = new Date();
  document.getElementById('topbarDate').textContent = d.toLocaleDateString('tr-TR', {weekday:'long', year:'numeric', month:'long', day:'numeric'});

  // Login
  const USERS = {
    'tugsanemen': '123456',
    'migros_yonetici': '123456',
    'pt_yonetici': '123456'
  };

  function doLogin() {
    const u = document.getElementById('loginUser').value.trim();
    const p = document.getElementById('loginPass').value.trim();
    if (USERS[u] && USERS[u] === p) {
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('app').style.display = 'block';
    } else {
      document.getElementById('loginError').style.display = 'block';
    }
  }

  document.getElementById('loginPass').addEventListener('keypress', e => { if(e.key==='Enter') doLogin(); });
  document.getElementById('loginUser').addEventListener('keypress', e => { if(e.key==='Enter') doLogin(); });

  function doLogout() {
    document.getElementById('loginScreen').style.display = 'flex';
    document.getElementById('app').style.display = 'none';
    document.getElementById('loginUser').value = '';
    document.getElementById('loginPass').value = '';
    document.getElementById('loginError').style.display = 'none';
  }

  // Page routing
  const titles = {
    dashboard: 'Ana Sayfa',
    notifications: 'Bildirimler',
    health: 'Sağlık Anketi',
    km: 'KM Girişi',
    admin: 'Yönetici Paneli',
    profile: 'Profil & Ayarlar'
  };

  function showPage(id, navEl) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-' + id).classList.add('active');
    document.getElementById('topbarTitle').textContent = titles[id] || id;
    if (navEl) {
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      navEl.classList.add('active');
    }
    // Mobile
    document.querySelectorAll('.mobile-nav-item').forEach(n => n.classList.remove('active'));
    const mobileMap = {dashboard:0, health:1, km:2, admin:3, profile:4};
    if (mobileMap[id] !== undefined) {
      document.querySelectorAll('.mobile-nav-item')[mobileMap[id]].classList.add('active');
    }
  }

  function showPageMobile(id, el) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-' + id).classList.add('active');
    document.getElementById('topbarTitle').textContent = titles[id] || id;
    document.querySelectorAll('.mobile-nav-item').forEach(n => n.classList.remove('active'));
    el.classList.add('active');
  }

  // Health quiz
  const healthAnswers = new Array(7).fill(null);
  function answerQ(btn, ans, idx) {
    const btns = btn.parentElement.querySelectorAll('.q-btn');
    btns.forEach(b => { b.classList.remove('active'); });
    btn.classList.add('active');
    healthAnswers[idx] = ans;
    const score = healthAnswers.filter(a => a === 'yes').length;
    document.getElementById('healthScore').textContent = score;
    document.getElementById('healthBar').style.width = (score / 7 * 100) + '%';
  }

  function submitHealth() {
    const answered = healthAnswers.filter(a => a !== null).length;
    if (answered < 7) { alert('Lütfen tüm soruları cevaplayın! (' + answered + '/7 cevaplandı)'); return; }
    alert('✅ Sağlık anketi başarıyla gönderildi!');
  }

  // KM
  const kmData = { '34 ABC 123': 12450, '06 XYZ 789': 9800, '16 DEF 456': 15200, '34 GHI 321': 7300 };
  function updateKmDisplay() {
    const sel = document.getElementById('kmMotor');
    const val = parseInt(sel.value);
    document.getElementById('kmCurrentVal').textContent = val.toLocaleString('tr-TR');
  }

  function submitKm() {
    const newVal = parseInt(document.getElementById('kmNewVal').value);
    const sel = document.getElementById('kmMotor');
    const curVal = parseInt(sel.value);
    if (!newVal || isNaN(newVal)) { alert('Lütfen geçerli bir KM değeri girin'); return; }
    if (newVal <= curVal) { alert('Yeni KM değeri mevcut değerden büyük olmalıdır!'); return; }
    sel.value = newVal;
    document.getElementById('kmCurrentVal').textContent = newVal.toLocaleString('tr-TR');
    document.getElementById('kmNewVal').value = '';
    alert('✅ KM değeri başarıyla güncellendi: ' + newVal.toLocaleString('tr-TR') + ' km');
  }
</script>
</body>
</html>
