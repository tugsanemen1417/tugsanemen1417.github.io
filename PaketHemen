        // ========== BAKIM YAPTIRMA (KURYE) ==========

        function bakimYaptir() {
            if (!currentUser) return;
            
            const kmInput = document.getElementById('bakim-km-input');
            const bakimKm = parseInt(kmInput.value);
            
            if (!bakimKm || bakimKm <= 0) {
                alert('Geçerli bir KM girin!');
                return;
            }

            const kurye = kuryeler.find(k => k.id === currentUser.id);
            const motor = motorlar.find(m => m.plaka === kurye.plaka);
            
            if (!motor) {
                alert('Motor bulunamadı!');
                return;
            }

            if (bakimKm < motor.km) {
                alert(`Girilen KM (${bakimKm}), mevcut KM'den (${motor.km}) küçük olamaz!`);
                return;
            }

            // Motor KM'sini güncelle
            motor.km = bakimKm;
            motor.sonBakimKm = bakimKm;
            motor.sonBakimTarihi = new Date().toISOString();

            // Bakım kaydı oluştur
            const bakimKaydi = {
                id: Date.now(),
                plaka: motor.plaka,
                model: motor.model,
                km: bakimKm,
                sonrakiBakimKm: bakimKm + (motor.bakimAraligi || 1000),
                kuryeIsim: kurye.isim,
                kuryeId: kurye.id,
                tarih: new Date().toISOString(),
                not: ''
            };

            bakimKayitlari.push(bakimKaydi);
            saveData();

            // Formu temizle ve gösterimi güncelle
            kmInput.value = '';
            updateKuryeDisplay();
            
            alert(`✅ Bakım kaydedildi!\n\n📅 Tarih: ${new Date().toLocaleDateString('tr-TR')}\n🏍️ Plaka: ${motor.plaka}\n📊 KM: ${bakimKm.toLocaleString()}\n🔧 Sonraki Bakım: ${bakimKaydi.sonrakiBakimKm.toLocaleString()} km`);
        }

