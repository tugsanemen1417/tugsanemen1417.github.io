<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Motohemen — Filo Yönetim Sistemi</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

  :root {
    --bg: #0f0f13;
    --surface: #1a1a24;
    --surface2: #22222f;
    --border: #2e2e3e;
    --accent: #6c63ff;
    --accent2: #ff6584;
    --green: #22c55e;
    --yellow: #f59e0b;
    --red: #ef4444;
    --text: #e8e8f0;
    --text2: #9090a8;
    --migros: #ff6000;
    --pt: #6c63ff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); overflow: hidden; }

  /* ========== LOGIN ========== */
  #loginScreen {
    position: fixed; inset: 0; background: var(--bg);
    display: flex; align-items: center; justify-content: center; z-index: 1000;
    background-image: radial-gradient(ellipse at 20% 50%, rgba(108,99,255,0.15) 0%, transparent 60%),
                      radial-gradient(ellipse at 80% 20%, rgba(255,101,132,0.1) 0%, transparent 50%);
  }
  .login-box {
    background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
    padding: 48px 40px; width: 380px; text-align: center;
    box-shadow: 0 40px 80px rgba(0,0,0,0.5);
  }
  .login-logo { font-size: 32px; margin-bottom: 8px; }
  .login-title { font-size: 24px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .login-sub { font-size: 13px; color: var(--text2); margin-bottom: 32px; }
  .login-hint {
    background: rgba(108,99,255,0.1); border: 1px solid rgba(108,99,255,0.3);
    border-radius: 10px; padding: 12px; margin-bottom: 24px; font-size: 12px; color: var(--text2);
  }
  .login-hint strong { color: var(--accent); }
  .form-group { margin-bottom: 16px; text-align: left; }
  .form-group label { font-size: 12px; color: var(--text2); margin-bottom: 6px; display: block; font-weight: 500; }
  .form-group input {
    width: 100%; background: var(--surface2); border: 1px solid var(--border);
    border-radius: 10px; padding: 12px 16px; color: var(--text); font-size: 14px;
    outline: none; transition: border 0.2s;
  }
  .form-group input:focus { border-color: var(--accent); }
  .login-btn {
    width: 100%; background: var(--accent); border: none; border-radius: 10px;
    padding: 13px; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer;
    transition: all 0.2s; margin-top: 8px;
  }
  .login-btn:hover { background: #7c74ff; transform: translateY(-1px); }
  .login-error { color: var(--red); font-size: 12px; margin-top: 10px; display: none; }

  /* ========== APP LAYOUT ========== */
  #app { display: none; height: 100vh; overflow: hidden; }
  .layout { display: flex; height: 100vh; }

  /* ========== SIDEBAR ========== */
  .sidebar {
    width: 240px; background: var(--surface); border-right: 1px solid var(--border);
    display: flex; flex-direction: column; flex-shrink: 0;
  }
  .sidebar-logo {
    padding: 20px 20px 16px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 10px;
  }
  .sidebar-logo .logo-icon { font-size: 22px; }
  .sidebar-logo .logo-text { font-size: 16px; font-weight: 700; color: var(--text); }
  .sidebar-logo .logo-version { font-size: 10px; color: var(--accent); background: rgba(108,99,255,0.15); padding: 2px 6px; border-radius: 4px; font-weight: 600; }
  .sidebar-user {
    padding: 16px 20px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 10px;
  }
  .user-avatar { width: 34px; height: 34px; background: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff; flex-shrink: 0; }
  .user-info .user-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .user-info .user-role { font-size: 11px; color: var(--text2); }
  .sidebar-nav { flex: 1; padding: 12px 0; overflow-y: auto; }
  .nav-section { padding: 8px 20px 4px; font-size: 10px; font-weight: 600; color: var(--text2); text-transform: uppercase; letter-spacing: 1px; }
  .nav-item {
    display: flex; align-items: center; gap: 10px; padding: 10px 20px;
    cursor: pointer; transition: all 0.15s; border-left: 3px solid transparent;
    font-size: 13px; color: var(--text2); font-weight: 500;
  }
  .nav-item:hover { background: rgba(255,255,255,0.04); color: var(--text); }
  .nav-item.active { background: rgba(108,99,255,0.1); color: var(--accent); border-left-color: var(--accent); }
  .nav-item .nav-icon { font-size: 15px; width: 20px; text-align: center; }
  .nav-badge { margin-left: auto; background: var(--red); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 10px; }
  .sidebar-footer { padding: 16px 20px; border-top: 1px solid var(--border); }
  .logout-btn {
    width: 100%; padding: 10px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2);
    border-radius: 8px; color: var(--red); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;
  }
  .logout-btn:hover { background: rgba(239,68,68,0.2); }

  /* ========== MAIN CONTENT ========== */
  .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
  .topbar {
    height: 60px; background: var(--surface); border-bottom: 1px solid var(--border);
    display: flex; align-items: center; padding: 0 24px; gap: 16px; flex-shrink: 0;
  }
  .topbar-title { font-size: 18px; font-weight: 700; color: var(--text); flex: 1; }
  .topbar-date { font-size: 12px; color: var(--text2); }
  .notif-btn {
    position: relative; background: none; border: none; cursor: pointer;
    font-size: 18px; color: var(--text2); padding: 4px;
  }
  .notif-dot { position: absolute; top: 0; right: 0; width: 8px; height: 8px; background: var(--red); border-radius: 50%; border: 2px solid var(--surface); }
  .content { flex: 1; overflow-y: auto; padding: 24px; }

  /* ========== PAGES ========== */
  .page { display: none; }
  .page.active { display: block; }

  /* ========== STAT CARDS ========== */
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
  .stat-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px;
  }
  .stat-card .stat-label { font-size: 11px; color: var(--text2); font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
  .stat-card .stat-value { font-size: 32px; font-weight: 700; color: var(--text); line-height: 1; margin-bottom: 6px; }
  .stat-card .stat-change { font-size: 12px; }
  .stat-card .stat-change.up { color: var(--green); }
  .stat-card .stat-change.warn { color: var(--yellow); }
  .stat-card .stat-change.down { color: var(--red); }
  .stat-card .stat-icon { font-size: 28px; float: right; margin-top: -40px; opacity: 0.5; }

  /* ========== GRID LAYOUTS ========== */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 24px; }
  .card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px;
  }
  .card-title { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 16px; display: flex; align-items: center; justify-content: between; gap: 8px; }
  .card-link { margin-left: auto; font-size: 12px; color: var(--accent); cursor: pointer; font-weight: 500; }

  /* ========== OPERATION CARDS ========== */
  .op-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
  .op-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px;
  }
  .op-header { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .op-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .op-dot.migros { background: var(--migros); }
  .op-dot.pt { background: var(--pt); }
  .op-name { font-size: 15px; font-weight: 700; color: var(--text); }
  .op-count { font-size: 32px; font-weight: 800; color: var(--text); line-height: 1; }
  .op-sub { font-size: 12px; color: var(--text2); margin-top: 2px; }

  /* ========== ALERTS ========== */
  .alert-item {
    display: flex; align-items: flex-start; gap: 12px; padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .alert-item:last-child { border-bottom: none; }
  .alert-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
  .alert-icon.critical { background: rgba(239,68,68,0.15); }
  .alert-icon.warning { background: rgba(245,158,11,0.15); }
  .alert-icon.info { background: rgba(34,197,94,0.15); }
  .alert-title { font-size: 13px; font-weight: 600; color: var(--text); }
  .alert-desc { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .alert-time { margin-left: auto; font-size: 11px; color: var(--text2); flex-shrink: 0; }

  /* ========== MOTOR LIST ========== */
  .motor-item {
    display: flex; align-items: center; gap: 12px; padding: 12px 0;
    border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.15s;
  }
  .motor-item:last-child { border-bottom: none; }
  .motor-item:hover { background: rgba(255,255,255,0.02); }
  .motor-icon { font-size: 20px; width: 36px; height: 36px; background: var(--surface2); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .motor-info { flex: 1; }
  .motor-plate { font-size: 13px; font-weight: 700; color: var(--text); }
  .motor-driver { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .motor-progress { margin-top: 6px; }
  .progress-bar { height: 4px; background: var(--surface2); border-radius: 2px; overflow: hidden; }
  .progress-fill { height: 100%; border-radius: 2px; transition: width 0.3s; }
  .progress-fill.ok { background: var(--green); }
  .progress-fill.warn { background: var(--yellow); }
  .progress-fill.danger { background: var(--red); }
  .progress-text { font-size: 10px; color: var(--text2); margin-top: 3px; }
  .motor-badges { display: flex; gap: 4px; flex-direction: column; align-items: flex-end; }
  .badge { padding: 3px 8px; border-radius: 5px; font-size: 10px; font-weight: 600; }
  .badge.active { background: rgba(34,197,94,0.15); color: var(--green); }
  .badge.warn { background: rgba(245,158,11,0.15); color: var(--yellow); }
  .badge.danger { background: rgba(239,68,68,0.15); color: var(--red); }
  .badge.idle { background: rgba(144,144,168,0.15); color: var(--text2); }
  .badge.rental { background: rgba(108,99,255,0.15); color: var(--accent); }

  /* ========== HEALTH PAGE ========== */
  .health-header { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px; margin-bottom: 20px; }
  .health-selector { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .health-selector select { background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; color: var(--text); font-size: 13px; outline: none; cursor: pointer; }
  .health-score-box { display: flex; align-items: center; gap: 16px; }
  .score-circle { width: 64px; height: 64px; border-radius: 50%; background: conic-gradient(var(--green) 0%, var(--surface2) 0%); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; color: var(--text); position: relative; }
  .score-label { font-size: 13px; color: var(--text2); }
  .score-val { font-size: 24px; font-weight: 800; color: var(--text); }
  .question-list { display: flex; flex-direction: column; gap: 10px; }
  .question-item {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .question-text { font-size: 13px; color: var(--text); font-weight: 500; }
  .question-btns { display: flex; gap: 8px; }
  .q-btn {
    padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s;
  }
  .q-btn.yes { background: rgba(34,197,94,0.15); color: var(--green); border: 1px solid rgba(34,197,94,0.2); }
  .q-btn.yes.active { background: var(--green); color: #000; }
  .q-btn.no { background: rgba(239,68,68,0.15); color: var(--red); border: 1px solid rgba(239,68,68,0.2); }
  .q-btn.no.active { background: var(--red); color: #fff; }

  /* ========== KM PAGE ========== */
  .km-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; margin-bottom: 16px; }
  .km-current { text-align: center; padding: 20px 0; }
  .km-current .km-value { font-size: 48px; font-weight: 800; color: var(--text); }
  .km-current .km-unit { font-size: 16px; color: var(--text2); }
  .km-current .km-label { font-size: 12px; color: var(--text2); margin-top: 4px; }
  .km-input-group { display: flex; gap: 10px; margin-top: 16px; }
  .km-input-group input { flex: 1; background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; color: var(--text); font-size: 16px; font-weight: 600; outline: none; }
  .km-input-group input:focus { border-color: var(--accent); }
  .km-submit { padding: 12px 24px; background: var(--accent); border: none; border-radius: 10px; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .km-submit:hover { background: #7c74ff; }
  .km-history-item { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .km-history-item:last-child { border-bottom: none; }
  .km-hist-val { font-size: 14px; font-weight: 700; color: var(--text); }
  .km-hist-time { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .km-hist-diff { font-size: 12px; color: var(--green); font-weight: 600; }
  .maintenance-info { background: var(--surface2); border-radius: 10px; padding: 16px; margin-top: 16px; }
  .maint-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .maint-label { font-size: 12px; color: var(--text2); }
  .maint-value { font-size: 13px; font-weight: 600; color: var(--text); }

  /* ========== ADMIN PAGE ========== */
  .admin-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
  .admin-stat { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; text-align: center; }
  .admin-stat .as-val { font-size: 28px; font-weight: 800; color: var(--text); }
  .admin-stat .as-label { font-size: 11px; color: var(--text2); margin-top: 4px; }
  .op-section { margin-bottom: 20px; }
  .op-section-title { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
  .motor-table { width: 100%; border-collapse: collapse; }
  .motor-table th { font-size: 11px; color: var(--text2); font-weight: 600; padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); text-transform: uppercase; letter-spacing: 0.5px; }
  .motor-table td { font-size: 13px; color: var(--text); padding: 12px; border-bottom: 1px solid var(--border); }
  .motor-table tr:last-child td { border-bottom: none; }
  .motor-table tr:hover td { background: rgba(255,255,255,0.02); }
  .users-list { display: flex; flex-direction: column; gap: 8px; }
  .user-item { display: flex; align-items: center; gap: 12px; padding: 14px; background: var(--surface2); border-radius: 10px; }
  .user-item-avatar { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; color: #fff; flex-shrink: 0; }
  .ua-main { background: var(--accent); }
  .ua-migros { background: var(--migros); }
  .ua-pt { background: var(--pt); }
  .user-item-name { font-size: 13px; font-weight: 700; color: var(--text); }
  .user-item-role { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .user-item-badge { margin-left: auto; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; }
  .monthly-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .monthly-stat { background: var(--surface2); border-radius: 10px; padding: 16px; text-align: center; }
  .monthly-stat .ms-val { font-size: 22px; font-weight: 800; color: var(--text); }
  .monthly-stat .ms-label { font-size: 11px; color: var(--text2); margin-top: 4px; }

  /* ========== PROFILE PAGE ========== */
  .profile-header { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; margin-bottom: 16px; text-align: center; }
  .profile-avatar { width: 80px; height: 80px; background: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 800; color: #fff; margin: 0 auto 12px; }
  .profile-name { font-size: 20px; font-weight: 800; color: var(--text); }
  .profile-role { font-size: 13px; color: var(--accent); margin-top: 4px; font-weight: 600; }
  .profile-stats { display: flex; gap: 32px; justify-content: center; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
  .profile-stat-val { font-size: 22px; font-weight: 800; color: var(--text); text-align: center; }
  .profile-stat-label { font-size: 11px; color: var(--text2); text-align: center; margin-top: 2px; }
  .settings-list { display: flex; flex-direction: column; gap: 8px; }
  .settings-item {
    display: flex; align-items: center; gap: 14px; padding: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; cursor: pointer; transition: all 0.15s;
  }
  .settings-item:hover { border-color: var(--accent); background: rgba(108,99,255,0.05); }
  .settings-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; background: var(--surface2); flex-shrink: 0; }
  .settings-text { font-size: 13px; font-weight: 600; color: var(--text); }
  .settings-sub { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .settings-arrow { margin-left: auto; color: var(--text2); font-size: 14px; }
  .settings-item.logout-item { border-color: rgba(239,68,68,0.2); }
  .settings-item.logout-item:hover { border-color: var(--red); background: rgba(239,68,68,0.05); }
  .settings-item.logout-item .settings-text { color: var(--red); }

  /* ========== SCROLLBAR ========== */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  /* ========== MOBILE NAV ========== */
  .mobile-nav { display: none; }

  @media (max-width: 768px) {
    .sidebar { display: none; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .grid-2, .grid-3, .op-cards { grid-template-columns: 1fr; }
    .admin-stats, .monthly-grid { grid-template-columns: 1fr 1fr; }
    .mobile-nav {
      display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
      background: var(--surface); border-top: 1px solid var(--border);
      padding: 8px 0 12px;
    }
    .mobile-nav-item {
      flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
      font-size: 10px; color: var(--text2); cursor: pointer; padding: 4px 0; transition: color 0.15s;
    }
    .mobile-nav-item.active { color: var(--accent); }
    .mobile-nav-item span:first-child { font-size: 20px; }
    .main { padding-bottom: 64px; }
    .content { padding: 16px; }
  }

  .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .section-title { font-size: 15px; font-weight: 700; color: var(--text); }
  .see-all { font-size: 12px; color: var(--accent); cursor: pointer; font-weight: 500; }
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="login-box">
    <div class="login-logo">🏍️</div>
    <div class="login-title">motohemen</div>
    <div class="login-sub">Filo Yönetim Sistemine Giriş</div>
    <div class="login-hint">👤 Admin: <strong>tugsanemen</strong> / <strong>123456</strong></div>
    <div class="form-group">
      <label>Kullanıcı Adı</label>
      <input type="text" id="loginUser" placeholder="Kullanıcı adınız">
    </div>
    <div class="form-group">
      <label>Şifre</label>
      <input type="password" id="loginPass" placeholder="••••••">
    </div>
    <button class="login-btn" onclick="doLogin()">Giriş Yap</button>
    <div class="login-error" id="loginError">❌ Kullanıcı adı veya şifre hatalı</div>
  </div>
</div>

<!-- APP -->
<div id="app">
  <div class="layout">

    <!-- SIDEBAR -->
    <div class="sidebar">
      <div class="sidebar-logo">
        <span class="logo-icon">🏍️</span>
        <span class="logo-text">motohemen</span>
        <span class="logo-version">v2.0</span>
      </div>
      <div class="sidebar-user">
        <div class="user-avatar">T</div>
        <div class="user-info">
          <div class="user-name">tugsanemen</div>
          <div class="user-role">👑 Ana Yönetici</div>
        </div>
      </div>
      <nav class="sidebar-nav">
        <div class="nav-section">Ana</div>
        <div class="nav-item active" onclick="showPage('dashboard', this)">
