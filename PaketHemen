        function saveMotor() {
            const id = document.getElementById('motor-id').value;
            const plaka = document.getElementById('motor-modal-plaka').value.trim().toUpperCase();
            const model = document.getElementById('motor-modal-model').value.trim();
            const yil = parseInt(document.getElementById('motor-modal-yil').value) || new Date().getFullYear();
            const km = parseInt(document.getElementById('motor-modal-km').value) || 0;
            const bakimAraligi = parseInt(document.getElementById('motor-modal-bakim-araligi').value) || 1000;

            if (!plaka || !model) {
                alert('Plaka ve model zorunludur!');
                return;
            }

            const mevcut = motorlar.find(m => m.plaka === plaka && m.id != id);
            if (mevcut) {
                alert('Bu plaka zaten kayıtlı!');
                return;
            }

            if (id) {
                const motor = motorlar.find(m => m.id == id);
                if (motor) {
                    motor.plaka = plaka;
                    motor.model = model;
                    motor.yil = yil;
                    motor.km = km;
                    motor.bakimAraligi = bakimAraligi;
                }
            } else {
                motorlar.push({
                    id: Date.now(),
                    plaka: plaka,
                    model: model,
                    yil: yil,
                    km: km,
                    bakimAraligi: bakimAraligi,
                    tarih: new Date().toISOString()
                });
            }

            saveData();
            closeModal('motor');
            renderMotorList();
            renderBakimKayitlari();
        }

        function editMotor(id) {
            const motor = motorlar.find(m => m.id === id);
            if (!motor) return;

            document.getElementById('motor-modal-title').textContent = 'Motor Düzenle';
            document.getElementById('motor-id').value = motor.id;
            document.getElementById('motor-modal-plaka').value = motor.plaka;
            document.getElementById('motor-modal-model').value = motor.model;
            document.getElementById('motor-modal-yil').value = motor.yil;
            document.getElementById('motor-modal-km').value = motor.km;
            document.getElementById('motor-modal-bakim-araligi').value = motor.bakimAraligi || 1000;
            
            document.getElementById('modal-motor').classList.add('active');
        }

        function deleteMotor(id) {
            if (!confirm('Bu motoru silmek istediğinize emin misiniz?')) return;
            
            const motor = motorlar.find(m => m.id === id);
            if (motor) {
                kuryeler.forEach(k => {
                    if (k.plaka === motor.plaka) k.plaka = '';
                });
                // Bakım kayıtlarını da temizle
                bakimKayitlari = bakimKayitlari.filter(b => b.plaka !== motor.plaka);
                saveData();
            }
            
            motorlar = motorlar.filter(m => m.id !== id);
            saveData();
            renderMotorList();
            renderKuryeList();
            renderBakimKayitlari();
        }

        function renderBakimKayitlari() {
            const tbody = document.getElementById('bakim-kayitlari-table');
            
            if (bakimKayitlari.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">Henüz bakım kaydı yok.</td></tr>';
                return;
            }

            // Tarihe göre sırala (en yeni üstte)
            const sirali = [...bakimKayitlari].sort((a, b) => new Date(b.tarih) - new Date(a.tarih));

            tbody.innerHTML = sirali.map(b => `
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm">${new Date(b.tarih).toLocaleDateString('tr-TR')}</td>
                    <td class="px-4 py-3 font-bold">${b.plaka}</td>
                    <td class="px-4 py-3 text-sm">${b.model}</td>
                    <td class="px-4 py-3 font-bold text-brand-blue">${b.km.toLocaleString()}</td>
                    <td class="px-4 py-3 text-sm">${b.kuryeIsim}</td>
                    <td class="px-4 py-3 font-bold text-brand-orange">${b.sonrakiBakimKm.toLocaleString()}</td>
                </tr>
            `).join('');
        }

        function getDurumColor(durum) {
            const colors = {
                'müsait': 'bg-green-100 text-green-700',
                'dagitim': 'bg-blue-100 text-blue-700',
                'mola': 'bg-yellow-100 text-yellow-700',
                'servis': 'bg-red-100 text-red-700'
            };
            return colors[durum] || 'bg-gray-100 text-gray-700';
        }

        // ========== HARİTALAR ==========

        function initKuryeMap() {
            if (document.getElementById('map-kurye')._leaflet_id) return;
            
            const map = L.map('map-kurye').setView([41.0082, 28.9784], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
            
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(pos => {
                    L.marker([pos.coords.latitude, pos.coords.longitude])
                        .addTo(map)
                        .bindPopup('📍 Siz buradasınız')
                        .openPopup();
                    map.setView([pos.coords.latitude, pos.coords.longitude], 15);
                });
            }
        }

        function initAdminMap() {
            if (document.getElementById('map-admin')._leaflet_id) return;
            
            const map = L.map('map-admin').setView([41.0082, 28.9784], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
            
            kuryeler.forEach(k => {
                const lat = 41.0082 + (Math.random() - 0.5) * 0.1;
                const lng = 28.9784 + (Math.random() - 0.5) * 0.1;
                L.marker([lat, lng])
                    .addTo(map)
                    .bindPopup(`🛵 ${k.isim}<br>📍 ${k.durum}`);
            });
        }

        // ========== BAŞLANGIÇ ==========
        
        document.addEventListener('DOMContentLoaded', () => {
            loadData();
        });

        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.classList.remove('active');
                }
            });
        });
    </script>
</body>
</html>
