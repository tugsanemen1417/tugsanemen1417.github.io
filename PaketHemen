<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🛵 MotoTakip Pro - Kurye & Filo Yönetimi</title>
    
    <script src="https://cdn.tailwindcss.com "></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css ">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400 ;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Nunito', 'sans-serif'] },
                    colors: {
                        brand: {
                            yellow: '#FBBF24',
                            orange: '#F97316',
                            darkOrange: '#EA580C',
                            lightYellow: '#FEF3C7',
                            cream: '#FFFBEB',
                            dark: '#1F2937',
                            green: '#10B981',
                            red: '#EF4444',
                            blue: '#3B82F6'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body { font-family: 'Nunito', sans-serif; }
        .gradient-bg { background: linear-gradient(135deg, #FBBF24 0%, #F97316 50%, #EA580C 100%); }
        .gradient-text { background: linear-gradient(135deg, #F97316, #EA580C); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(249, 115, 22, 0.3); }
        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 100; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
        .modal.active { display: flex; }
        .modal-content { background: white; border-radius: 1.5rem; padding: 2rem; max-width: 800px; width: 90%; max-height: 90vh; overflow-y: auto; border: 3px solid #FBBF24; }
        .btn-primary { background: linear-gradient(135deg, #FBBF24, #F97316); color: white; font-weight: 800; transition: all 0.3s; }
        .btn-primary:hover { transform: scale(1.05); box-shadow: 0 10px 30px rgba(249, 115, 22, 0.4); }
        .feedback-box { border: 3px solid #FEF3C7; border-radius: 1rem; padding: 1rem; background: white; transition: all 0.3s; }
        .feedback-box:hover { border-color: #F97316; transform: scale(1.02); }
        .status-btn { padding: 0.5rem 1rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 700; transition: all 0.2s; border: 2px solid transparent; }
        .status-btn:hover { transform: scale(1.05); }
        .status-btn.selected { ring: 3px; ring-offset: 2px; }
        .status-iyi { background: #D1FAE5; color: #059669; border-color: #10B981; }
        .status-orta { background: #FEF3C7; color: #D97706; border-color: #FBBF24; }
        .status-kotu { background: #FEE2E2; color: #DC2626; border-color: #EF4444; }
        .status-degistirildi { background: #DBEAFE; color: #2563EB; border-color: #3B82F6; }
        .print-area { background: white; padding: 2rem; border-radius: 1rem; }
        @media print { body * { visibility: hidden; } .print-area, .print-area * { visibility: visible; } .print-area { position: absolute; left: 0; top: 0; width: 100%; } .no-print { display: none !important; } }
    </style>
</head>
<body class="bg-brand-cream">

    <!-- LOGIN SCREEN -->
    <div id="login-screen" class="fixed inset-0 z-50 gradient-bg flex items-center justify-center p-4">
        <div class="max-w-4xl w-full grid md:grid-cols-2 gap-8">
            <div class="bg-white/20 backdrop-blur-md rounded-3xl p-8 text-white border-4 border-white/30 cursor-pointer hover:scale-105 transition-transform" onclick="showKuryeLogin()">
                <div class="text-center">
                    <div class="text-6xl mb-4 animate-bounce">🛵</div>
                    <h2 class="text-3xl font-bold mb-2">Kurye Girişi</h2>
                    <p class="text-white/80 text-sm mb-4">Plakanızı girerek giriş yapın</p>
                    
                    <div id="kurye-form" class="hidden space-y-4 text-left mt-6">
                        <input type="text" id="kurye-isim" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70 focus:bg-white/30 focus:border-white transition-all" placeholder="İsim Soyisim">
                        <input type="text" id="kurye-plaka" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70 focus:bg-white/30 focus:border-white transition-all uppercase" placeholder="Plaka (örn: 34 ABC 123)">
                        <input type="text" id="kurye-telefon" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70 focus:bg-white/30 focus:border-white transition-all" placeholder="Telefon (İsteğe Bağlı)">
                        <button onclick="loginKurye()" class="w-full py-3 bg-white text-brand-orange font-bold rounded-xl hover:bg-brand-lightYellow transition-all transform hover:scale-105 shadow-lg">
                            🚀 Göreve Başla
                        </button>
                    </div>
                    <button id="kurye-btn" class="mt-4 px-8 py-3 bg-white/30 rounded-full font-bold hover:bg-white/50 transition-all border-2 border-white/50">
                        Giriş Yap <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>

            <div class="bg-white/20 backdrop-blur-md rounded-3xl p-8 text-white border-4 border-white/30 cursor-pointer hover:scale-105 transition-transform" onclick="showAdminLogin()">
                <div class="text-center">
                    <div class="text-6xl mb-4 animate-bounce" style="animation-delay: 0.5s">👨‍💼</div>
                    <h2 class="text-3xl font-bold mb-2">Yönetici Girişi</h2>
                    <div id="admin-form" class="hidden space-y-4 text-left mt-6">
                        <input type="text" id="admin-user" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70" placeholder="Kullanıcı adı">
                        <input type="password" id="admin-pass" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70" placeholder="Şifre">
                        <button onclick="loginAdmin()" class="w-full py-3 bg-brand-darkOrange text-white font-bold rounded-xl hover:bg-orange-700 transition-all">
                            🔑 Panele Git
                        </button>
                    </div>
                    <button id="admin-btn" class="mt-4 px-8 py-3 bg-white/30 rounded-full font-bold hover:bg-white/50 transition-all border-2 border-white/50">
                        Giriş Yap <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- KURYE PANEL -->
    <div id="kurye-panel" class="hidden min-h-screen bg-gradient-to-br from-brand-lightYellow to-orange-100">
        <header class="bg-gradient-to-r from-brand-yellow to-brand-orange text-white p-4 sticky top-0 z-40 shadow-lg">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <div class="flex items-center space-x-3">
                    <span class="text-3xl">🛵</span>
                    <div>
                        <h1 class="font-bold text-lg">MotoTakip</h1>
                        <p class="text-xs opacity-90" id="kurye-plaka-display">-</p>
                    </div>
                </div>
                <button onclick="logout()" class="p-2 bg-white/20 rounded-lg hover:bg-white/30 transition-all">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </header>

        <div class="max-w-7xl mx-auto p-4 space-y-4">
            <!-- Motor Bilgisi -->
            <div class="bg-white rounded-2xl p-6 shadow-xl border-2 border-brand-yellow/30">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold text-brand-dark">🏍️ Motor Bilgisi</h2>
                    <button onclick="showMotorHistoryKurye()" class="px-4 py-2 bg-brand-orange text-white rounded-lg text-sm font-bold hover:bg-brand-darkOrange transition-all">
                        <i class="fas fa-history mr-2"></i>Bakım Geçmişi
                    </button>
                </div>
                <div id="kurye-motor-info" class="space-y-3">
                    <p class="text-gray-500 text-center">Motor bilgisi yükleniyor...</p>
                </div>
            </div>

            <!-- Kurye Geri Bildirimi -->
            <div class="bg-white rounded-2xl p-6 shadow-xl border-2 border-brand-orange/30">
                <h2 class="text-xl font-bold text-brand-dark mb-4 flex items-center">
                    <i class="fas fa-clipboard-check mr-2 text-brand-orange"></i>
                    Kurye Geri Bildirimi
                </h2>
                <p class="text-sm text-gray-600 mb-4">Motor durumunu kontrol edin ve bildirin:</p>
                
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="geri-bildirim-grid">
                    <!-- Lastikler -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-circle text-2xl mr-2 text-gray-700"></i>
                                Lastikler
                            </span>
                            <i class="fas fa-road text-brand-orange"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('lastik', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="lastik">✓ İyi</button>
                            <button onclick="selectFeedback('lastik', 'orta')" class="feedback-btn status-btn status-orta" data-type="lastik">~ Orta</button>
                            <button onclick="selectFeedback('lastik', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="lastik">✗ Kötü</button>
                            <button onclick="selectFeedback('lastik', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="lastik">🔄 Yeni</button>
                        </div>
                    </div>

                    <!-- Ön Ampul -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-lightbulb text-2xl mr-2 text-yellow-400"></i>
                                Ön Ampul
                            </span>
                            <i class="fas fa-sun text-brand-yellow"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('on_ampul', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="on_ampul">✓ Çalışıyor</button>
                            <button onclick="selectFeedback('on_ampul', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="on_ampul">✗ Arızalı</button>
                            <button onclick="selectFeedback('on_ampul', 'orta')" class="feedback-btn status-btn status-orta" data-type="on_ampul">~ Sönük</button>
                            <button onclick="selectFeedback('on_ampul', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="on_ampul">🔄 Yeni</button>
                        </div>
                    </div>

                    <!-- Arka Ampul -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-lightbulb text-2xl mr-2 text-red-500"></i>
                                Arka Ampul
                            </span>
                            <i class="fas fa-sun text-brand-orange"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('arka_ampul', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="arka_ampul">✓ Çalışıyor</button>
                            <button onclick="selectFeedback('arka_ampul', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="arka_ampul">✗ Arızalı</button>
                            <button onclick="selectFeedback('arka_ampul', 'orta')" class="feedback-btn status-btn status-orta" data-type="arka_ampul">~ Sönük</button>
                            <button onclick="selectFeedback('arka_ampul', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="arka_ampul">🔄 Yeni</button>
                        </div>
                    </div>

                    <!-- Balata -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-compact-disc text-2xl mr-2 text-gray-600"></i>
                                Balata
                            </span>
                            <i class="fas fa-hand-paper text-brand-orange"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('balata', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="balata">✓ İyi</button>
                            <button onclick="selectFeedback('balata', 'orta')" class="feedback-btn status-btn status-orta" data-type="balata">~ Aşınmış</button>
                            <button onclick="selectFeedback('balata', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="balata">✗ Bitmiş</button>
                            <button onclick="selectFeedback('balata', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="balata">🔄 Yeni</button>
                        </div>
                    </div>

                    <!-- Zincir -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-link text-2xl mr-2 text-gray-700"></i>
                                Zincir
                            </span>
                            <i class="fas fa-cog text-brand-orange"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('zincir', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="zincir">✓ Gergin</button>
                            <button onclick="selectFeedback('zincir', 'orta')" class="feedback-btn status-btn status-orta" data-type="zincir">~ Gevşek</button>
                            <button onclick="selectFeedback('zincir', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="zincir">✗ Paslı</button>
                            <button onclick="selectFeedback('zincir', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="zincir">🔄 Yeni</button>
                        </div>
                    </div>

                    <!-- Akü -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-battery-full text-2xl mr-2 text-green-500"></i>
                                Akü
                            </span>
                            <i class="fas fa-bolt text-brand-yellow"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('aku', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="aku">✓ Dolu</button>
                            <button onclick="selectFeedback('aku', 'orta')" class="feedback-btn status-btn status-orta" data-type="aku">~ Zayıf</button>
                            <button onclick="selectFeedback('aku', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="aku">✗ Bitik</button>
                            <button onclick="selectFeedback('aku', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="aku">🔄 Yeni</button>
                        </div>
                    </div>

                    <!-- Yağ Seviyesi -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-oil-can text-2xl mr-2 text-amber-600"></i>
                                Yağ Seviyesi
                            </span>
                            <i class="fas fa-tint text-brand-orange"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('yag', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="yag">✓ Yeterli</button>
                            <button onclick="selectFeedback('yag', 'orta')" class="feedback-btn status-btn status-orta" data-type="yag">~ Azalmış</button>
                            <button onclick="selectFeedback('yag', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="yag">✗ Kritik</button>
                            <button onclick="selectFeedback('yag', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="yag">🔄 Değişti</button>
                        </div>
                    </div>

                    <!-- Lastik Hava Basıncı -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-wind text-2xl mr-2 text-blue-400"></i>
                                Hava Basıncı
                            </span>
                            <i class="fas fa-compress-arrows-alt text-brand-blue"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('hava', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="hava">✓ Normal</button>
                            <button onclick="selectFeedback('hava', 'orta')" class="feedback-btn status-btn status-orta" data-type="hava">~ Düşük</button>
                            <button onclick="selectFeedback('hava', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="hava">✗ Patlak</button>
                            <button onclick="selectFeedback('hava', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="hava">🔄 Tamir</button>
                        </div>
                    </div>

                    <!-- Genel Görünüm -->
                    <div class="feedback-box">
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-bold text-brand-dark flex items-center">
                                <i class="fas fa-eye text-2xl mr-2 text-purple-500"></i>
                                Genel Görünüm
                            </span>
                            <i class="fas fa-motorcycle text-brand-purple"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="selectFeedback('gorunum', 'iyi')" class="feedback-btn status-btn status-iyi" data-type="gorunum">✓ İyi</button>
                            <button onclick="selectFeedback('gorunum', 'orta')" class="feedback-btn status-btn status-orta" data-type="gorunum">~ Çizik</button>
                            <button onclick="selectFeedback('gorunum', 'kotu')" class="feedback-btn status-btn status-kotu" data-type="gorunum">✗ Hasarlı</button>
                            <button onclick="selectFeedback('gorunum', 'degistirildi')" class="feedback-btn status-btn status-degistirildi" data-type="gorunum">🔄 Boyandı</button>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="block text-sm font-bold text-gray-700 mb-2">📝 Ekstra Not (İsteğe Bağlı)</label>
                    <textarea id="geri-bildirim-not" rows="3" class="w-full px-4 py-3 rounded-xl border-2 border-brand-yellow focus:border-brand-orange outline-none" placeholder="Varsa ekstra sorunları buraya yazın..."></textarea>
                </div>

                <button onclick="saveGeriBildirim()" class="w-full mt-4 py-3 btn-primary rounded-xl text-lg shadow-lg">
                    <i class="fas fa-paper-plane mr-2"></i>Geri Bildirimi Gönder
                </button>
            </div>

            <!-- Bakım İşlemi -->
            <div class="bg-white rounded-2xl p-6 shadow-xl border-2 border-brand-orange/30">
                <h2 class="text-xl font-bold text-brand-dark mb-4">🔧 Bakım Kaydı</h2>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">📍 Bakım Yapılan Yer</label>
                        <div class="grid grid-cols-2 gap-2" id="bakim-yerleri">
                            <button type="button" onclick="selectBakimYeri('Demir Motor')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">🔧 Demir Motor</button>
                            <button type="button" onclick="selectBakimYeri('Altay Lastik')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">🛞 Altay Lastik</button>
                            <button type="button" onclick="selectBakimYeri('Mustafa Yuca Manavgat')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">⚙️ Mustafa Yuca</button>
                            <button type="button" onclick="selectBakimYeri('Ataberk')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">🔩 Ataberk</button>
                            <button type="button" onclick="selectBakimYeri('Moto Bambam')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700 col-span-2">🏍️ Moto Bambam</button>
                        </div>
                        <input type="hidden" id="secili-bakim-yeri">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">⚙️ Bakım Tipi</label>
                        <div class="flex space-x-3">
                            <button type="button" onclick="selectBakimTipi('yag')" id="btn-yag" class="flex-1 p-4 rounded-xl border-2 border-brand-yellow bg-brand-lightYellow text-brand-darkOrange font-bold transform scale-105 shadow-lg transition-all">🛢️ Yağ Değişimi</button>
                            <button type="button" onclick="selectBakimTipi('genel')" id="btn-genel" class="flex-1 p-4 rounded-xl border-2 border-gray-200 text-gray-600 font-bold hover:border-brand-orange hover:bg-orange-50 transition-all">🔧 Genel Bakım</button>
                        </div>
                        <input type="hidden" id="secili-bakim-tipi" value="yag">
                        <p id="bakim-uyari" class="text-xs text-brand-orange mt-2 font-bold hidden">⚠️ 2 yağ değişiminden sonra genel bakım önerilir!</p>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">📊 Mevcut KM</label>
                        <input type="number" id="bakim-km-input" class="w-full px-4 py-3 rounded-xl border-2 border-brand-yellow focus:border-brand-orange outline-none text-lg font-bold" placeholder="Örn: 12500">
                    </div>

                    <button onclick="bakimYaptir()" class="w-full py-4 btn-primary rounded-xl text-lg shadow-lg">
                        <i class="fas fa-save mr-2"></i>Bakım Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- YÖNETİCİ PANEL -->
    <div id="admin-panel" class="hidden min-h-screen bg-brand-cream">
        <aside class="fixed left-0 top-0 h-full w-64 bg-gradient-to-b from-brand-dark to-gray-800 text-white p-6 z-40 transform -translate-x-full md:translate-x-0 transition-transform" id="sidebar">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-brand-yellow">🛵 MotoTakip</h1>
                <p class="text-xs text-gray-400 mt-1">Yönetim Paneli</p>
            </div>
            <nav class="space-y-2">
                <button onclick="showSection('dashboard')" class="w-full text-left px-4 py-3 rounded-xl bg-brand-yellow/20 text-brand-yellow border-l-4 border-brand-yellow font-bold">
                    <i class="fas fa-chart-line mr-3"></i> Dashboard
                </button>
                <button onclick="showSection('kuryeler')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10 transition-all">
                    <i class="fas fa-users mr-3"></i> Kuryeler
