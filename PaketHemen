<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🛵 MotoTakip Pro - Kurye & Filo Yönetimi</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Nunito', 'sans-serif'] },
                    colors: {
                        brand: {
                            yellow: '#FBBF24',
                            orange: '#F97316',
                            darkOrange: '#EA580C',
                            lightYellow: '#FEF3C7',
                            cream: '#FFFBEB',
                            dark: '#1F2937'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body { font-family: 'Nunito', sans-serif; }
        .gradient-bg { background: linear-gradient(135deg, #FBBF24 0%, #F97316 50%, #EA580C 100%); }
        .gradient-text { background: linear-gradient(135deg, #F97316, #EA580C); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(249, 115, 22, 0.3); }
        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 100; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
        .modal.active { display: flex; }
        .modal-content { background: white; border-radius: 1.5rem; padding: 2rem; max-width: 700px; width: 90%; max-height: 90vh; overflow-y: auto; border: 3px solid #FBBF24; }
        .btn-primary { background: linear-gradient(135deg, #FBBF24, #F97316); color: white; font-weight: 800; transition: all 0.3s; }
        .btn-primary:hover { transform: scale(1.05); box-shadow: 0 10px 30px rgba(249, 115, 22, 0.4); }
        .service-badge { display: inline-block; padding: 0.5rem 1rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 700; margin: 0.25rem; cursor: pointer; transition: all 0.2s; }
        .service-badge:hover { transform: scale(1.1); }
        .service-badge.selected { ring: 3px; ring-offset: 2px; ring-color: #F97316; }
        .oil-change { background: #FEF3C7; color: #D97706; border: 2px solid #FBBF24; }
        .general-maint { background: #FED7AA; color: #C2410C; border: 2px solid #F97316; }
        .print-area { background: white; padding: 2rem; border-radius: 1rem; }
        @media print { body * { visibility: hidden; } .print-area, .print-area * { visibility: visible; } .print-area { position: absolute; left: 0; top: 0; width: 100%; } .no-print { display: none !important; } }
    </style>
</head>
<body class="bg-brand-cream">

    <!-- LOGIN SCREEN -->
    <div id="login-screen" class="fixed inset-0 z-50 gradient-bg flex items-center justify-center p-4">
        <div class="max-w-4xl w-full grid md:grid-cols-2 gap-8">
            <!-- Kurye Girişi - Artık herhangi bir plaka ile giriş yapabilir -->
            <div class="bg-white/20 backdrop-blur-md rounded-3xl p-8 text-white border-4 border-white/30 cursor-pointer hover:scale-105 transition-transform" onclick="showKuryeLogin()">
                <div class="text-center">
                    <div class="text-6xl mb-4 animate-bounce">🛵</div>
                    <h2 class="text-3xl font-bold mb-2">Kurye Girişi</h2>
                    <p class="text-white/80 text-sm mb-4">Plakanızı girerek giriş yapın</p>
                    
                    <div id="kurye-form" class="hidden space-y-4 text-left mt-6">
                        <input type="text" id="kurye-isim" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70 focus:bg-white/30 focus:border-white transition-all" placeholder="İsim Soyisim">
                        <input type="text" id="kurye-plaka" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70 focus:bg-white/30 focus:border-white transition-all uppercase" placeholder="Plaka (örn: 34 ABC 123)">
                        <input type="text" id="kurye-telefon" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70 focus:bg-white/30 focus:border-white transition-all" placeholder="Telefon (İsteğe Bağlı)">
                        <button onclick="loginKurye()" class="w-full py-3 bg-white text-brand-orange font-bold rounded-xl hover:bg-brand-lightYellow transition-all transform hover:scale-105 shadow-lg">
                            🚀 Göreve Başla
                        </button>
                    </div>
                    <button id="kurye-btn" class="mt-4 px-8 py-3 bg-white/30 rounded-full font-bold hover:bg-white/50 transition-all border-2 border-white/50">
                        Giriş Yap <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>

            <!-- Yönetici Girişi -->
            <div class="bg-white/20 backdrop-blur-md rounded-3xl p-8 text-white border-4 border-white/30 cursor-pointer hover:scale-105 transition-transform" onclick="showAdminLogin()">
                <div class="text-center">
                    <div class="text-6xl mb-4 animate-bounce" style="animation-delay: 0.5s">👨‍💼</div>
                    <h2 class="text-3xl font-bold mb-2">Yönetici Girişi</h2>
                    <div id="admin-form" class="hidden space-y-4 text-left mt-6">
                        <input type="text" id="admin-user" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70" placeholder="Kullanıcı adı">
                        <input type="password" id="admin-pass" class="w-full px-4 py-3 rounded-xl bg-white/20 border-2 border-white/40 text-white placeholder-white/70" placeholder="Şifre">
                        <button onclick="loginAdmin()" class="w-full py-3 bg-brand-darkOrange text-white font-bold rounded-xl hover:bg-orange-700 transition-all">
                            🔑 Panele Git
                        </button>
                    </div>
                    <button id="admin-btn" class="mt-4 px-8 py-3 bg-white/30 rounded-full font-bold hover:bg-white/50 transition-all border-2 border-white/50">
                        Giriş Yap <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- KURYE PANEL -->
    <div id="kurye-panel" class="hidden min-h-screen bg-gradient-to-br from-brand-lightYellow to-orange-100">
        <header class="bg-gradient-to-r from-brand-yellow to-brand-orange text-white p-4 sticky top-0 z-40 shadow-lg">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <div class="flex items-center space-x-3">
                    <span class="text-3xl">🛵</span>
                    <div>
                        <h1 class="font-bold text-lg">MotoTakip</h1>
                        <p class="text-xs opacity-90" id="kurye-plaka-display">-</p>
                    </div>
                </div>
                <button onclick="logout()" class="p-2 bg-white/20 rounded-lg hover:bg-white/30 transition-all">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </header>

        <div class="max-w-7xl mx-auto p-4 space-y-4">
            <!-- Motor Bilgisi -->
            <div class="bg-white rounded-2xl p-6 shadow-xl border-2 border-brand-yellow/30">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold text-brand-dark">🏍️ Motor Bilgisi</h2>
                    <button onclick="showMotorHistoryKurye()" class="px-4 py-2 bg-brand-orange text-white rounded-lg text-sm font-bold hover:bg-brand-darkOrange transition-all">
                        <i class="fas fa-history mr-2"></i>Bakım Geçmişi
                    </button>
                </div>
                <div id="kurye-motor-info" class="space-y-3">
                    <p class="text-gray-500 text-center">Motor bilgisi yükleniyor...</p>
                </div>
            </div>

            <!-- Bakım İşlemi -->
            <div class="bg-white rounded-2xl p-6 shadow-xl border-2 border-brand-orange/30">
                <h2 class="text-xl font-bold text-brand-dark mb-4">🔧 Bakım Kaydı</h2>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">📍 Bakım Yapılan Yer</label>
                        <div class="grid grid-cols-2 gap-2" id="bakim-yerleri">
                            <button type="button" onclick="selectBakimYeri('Demir Motor')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">
                                🔧 Demir Motor
                            </button>
                            <button type="button" onclick="selectBakimYeri('Altay Lastik')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">
                                🛞 Altay Lastik
                            </button>
                            <button type="button" onclick="selectBakimYeri('Mustafa Yuca Manavgat')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">
                                ⚙️ Mustafa Yuca
                            </button>
                            <button type="button" onclick="selectBakimYeri('Ataberk')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700">
                                🔩 Ataberk
                            </button>
                            <button type="button" onclick="selectBakimYeri('Moto Bambam')" class="bakim-yeri-btn p-3 rounded-xl border-2 border-gray-200 hover:border-brand-orange hover:bg-brand-lightYellow transition-all text-sm font-bold text-gray-700 col-span-2">
                                🏍️ Moto Bambam
                            </button>
                        </div>
                        <input type="hidden" id="secili-bakim-yeri">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">⚙️ Bakım Tipi</label>
                        <div class="flex space-x-3">
                            <button type="button" onclick="selectBakimTipi('yag')" id="btn-yag" class="flex-1 p-4 rounded-xl border-2 border-brand-yellow bg-brand-lightYellow text-brand-darkOrange font-bold hover:scale-105 transition-all">
                                🛢️ Yağ Değişimi
                            </button>
                            <button type="button" onclick="selectBakimTipi('genel')" id="btn-genel" class="flex-1 p-4 rounded-xl border-2 border-gray-200 text-gray-600 font-bold hover:border-brand-orange hover:bg-orange-50 transition-all">
                                🔧 Genel Bakım
                            </button>
                        </div>
                        <input type="hidden" id="secili-bakim-tipi" value="yag">
                        <p id="bakim-uyari" class="text-xs text-brand-orange mt-2 font-bold hidden">
                            ⚠️ 2 yağ değişiminden sonra genel bakım önerilir!
                        </p>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">📊 Mevcut KM</label>
                        <input type="number" id="bakim-km-input" class="w-full px-4 py-3 rounded-xl border-2 border-brand-yellow focus:border-brand-orange outline-none text-lg font-bold" placeholder="Örn: 12500">
                    </div>

                    <button onclick="bakimYaptir()" class="w-full py-4 btn-primary rounded-xl text-lg shadow-lg">
                        <i class="fas fa-save mr-2"></i>Bakım Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- YÖNETİCİ PANEL -->
    <div id="admin-panel" class="hidden min-h-screen bg-brand-cream">
        <aside class="fixed left-0 top-0 h-full w-64 bg-gradient-to-b from-brand-dark to-gray-800 text-white p-6 z-40 transform -translate-x-full md:translate-x-0 transition-transform" id="sidebar">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-brand-yellow">🛵 MotoTakip</h1>
                <p class="text-xs text-gray-400 mt-1">Yönetim Paneli</p>
            </div>
            <nav class="space-y-2">
                <button onclick="showSection('dashboard')" class="w-full text-left px-4 py-3 rounded-xl bg-brand-yellow/20 text-brand-yellow border-l-4 border-brand-yellow font-bold">
                    <i class="fas fa-chart-line mr-3"></i> Dashboard
                </button>
                <button onclick="showSection('kuryeler')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10 transition-all">
                    <i class="fas fa-users mr-3"></i> Kuryeler
                </button>
                <button onclick="showSection('motors')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10 transition-all">
                    <i class="fas fa-motorcycle mr-3"></i> Motorlar
                </button>
                <button onclick="showSection('bakim')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10 transition-all">
                    <i class="fas fa-tools mr-3"></i> Bakım Kayıtları
                </button>
                <button onclick="showSection('rapor')" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/10 transition-all bg-brand-orange/20 text-brand-orange">
                    <i class="fas fa-file-pdf mr-3"></i> Rapor Oluştur
                </button>
            </nav>
            <button onclick="logout()" class="absolute bottom-6 left-6 right-6 py-3 bg-red-500 rounded-xl font-bold hover:bg-red-600 transition-all">
                <i class="fas fa-sign-out-alt mr-2"></i> Çıkış
            </button>
        </aside>

        <main class="md:ml-64 p-4 md:p-8">
            <div class="flex justify-between items-center mb-8">
                <button onclick="toggleSidebar()" class="md:hidden p-2 bg-white rounded-lg shadow text-brand-orange"><i class="fas fa-bars"></i></button>
                <h2 class="text-2xl font-bold text-brand-dark" id="page-title">📊 Dashboard</h2>
                <div class="flex items-center space-x-4">
                    <div class="bg-white px-4 py-2 rounded-lg shadow flex items-center space-x-2 border-2 border-brand-yellow">
                        <div class="w-8 h-8 bg-gradient-to-br from-brand-yellow to-brand-orange rounded-full flex items-center justify-center text-white font-bold">A</div>
                        <span class="font-bold text-sm hidden sm:block text-brand-dark">Admin</span>
                    </div>
                </div>
            </div>

            <!-- Dashboard -->
            <div id="section-dashboard" class="space-y-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-brand-yellow card-hover">
                        <p class="text-gray-500 text-sm font-bold">Toplam Kurye</p>
                        <p class="text-3xl font-bold text-brand-orange" id="stat-kurye">0</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-brand-orange card-hover">
                        <p class="text-gray-500 text-sm font-bold">Toplam Motor</p>
                        <p class="text-3xl font-bold text-brand-darkOrange" id="stat-motor">0</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-yellow-500 card-hover">
                        <p class="text-gray-500 text-sm font-bold">Yağ Değişimi</p>
                        <p class="text-3xl font-bold text-yellow-600" id="stat-yag">0</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-lg border-l-4 border-orange-600 card-hover">
                        <p class="text-gray-500 text-sm font-bold">Genel Bakım</p>
                        <p class="text-3xl font-bold text-orange-700" id="stat-genel">0</p>
                    </div>
                </div>
            </div>

            <!-- Kuryeler -->
            <div id="section-kuryeler" class="hidden space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="text-xl font-bold text-brand-dark">👥 Kurye Yönetimi</h3>
                    <button onclick="openModal('kurye-ekle')" class="px-6 py-3 btn-primary rounded-xl shadow-lg">
                        <i class="fas fa-plus mr-2"></i>Yeni Kurye
                    </button>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" id="kurye-list"></div>
            </div>

            <!-- Motorlar -->
            <div id="section-motors" class="hidden space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="text-xl font-bold text-brand-dark">🏍️ Motor Yönetimi</h3>
                    <button onclick="openModal('motor-ekle')" class="px-6 py-3 bg-gradient-to-r from-brand-orange to-brand-darkOrange text-white rounded-xl shadow-lg font-bold hover:scale-105 transition-all">
                        <i class="fas fa-plus mr-2"></i>Yeni Motor
                    </button>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" id="motor-list"></div>
            </div>

            <!-- Bakım Kayıtları -->
            <div id="section-bakim" class="hidden space-y-6">
                <h3 class="text-xl font-bold text-brand-dark">🔧 Tüm Bakım Kayıtları</h3>
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-brand-yellow/30">
                    <table class="w-full">
                        <thead class="bg-gradient-to-r from-brand-yellow to-brand-orange text-white">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-bold">Tarih</th>
                                <th class="px-4 py-3 text-left text-xs font-bold">Plaka</th>
                                <th class="px-4 py-3 text-left text-xs font-bold">Tip</th>
                                <th class="px-4 py-3 text-left text-xs font-bold">KM</th>
                                <th class="px-4 py-3 text-left text-xs font-bold">Yer</th>
                                <th class="px-4 py-3 text-left text-xs font-bold">Kurye</th>
                            </tr>
                        </thead>
                        <tbody id="bakim-kayitlari-table" class="divide-y divide-orange-100"></tbody>
                    </table>
                </div>
            </div>

            <!-- Rapor Oluştur -->
            <div id="section-rapor" class="hidden space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="text-xl font-bold text-brand-dark">📄 Rapor Oluştur</h3>
                    <div class="space-x-3">
                        <button onclick="generateReport()" class="px-6 py-3 btn-primary rounded-xl shadow-lg">
                            <i class="fas fa-sync-alt mr-2"></i>Raporu Güncelle
                        </button>
                        <button onclick="printReport()" class="px-6 py-3 bg-brand-dark text-white rounded-xl shadow-lg font-bold hover:bg-gray-800 transition-all">
                            <i class="fas fa-print mr-2"></i>Yazdır / PDF
                        </button>
                    </div>
                </div>

                <div class="print-area bg-white rounded-2xl shadow-xl border-4 border-brand-yellow p-8" id="rapor-icerik">
                    <div class="text-center mb-8 border-b-4 border-brand-orange pb-6">
                        <h1 class="text-4xl font-black gradient-text mb-2">MOTOTAKİP PRO</h1>
                        <p class="text-xl text-gray-600 font-bold">Filo Yönetim Raporu</p>
                        <p class="text-sm text-gray-500 mt-2" id="rapor-tarihi">-</p>
                    </div>

                    <div class="grid grid-cols-3 gap-4 mb-8">
                        <div class="bg-brand-lightYellow p-4 rounded-xl text-center border-2 border-brand-yellow">
                            <p class="text-3xl font-black text-brand-orange" id="rapor-kurye-sayisi">0</p>
                            <p class="text-sm font-bold text-gray-600">Toplam Kurye</p>
                        </div>
                        <div class="bg-orange-100 p-4 rounded-xl text-center border-2 border-brand-orange">
                            <p class="text-3xl font-black text-brand-darkOrange" id="rapor-motor-sayisi">0</p>
                            <p class="text-sm font-bold text-gray-600">Toplam Motor</p>
                        </div>
                        <div class="bg-yellow-100 p-4 rounded-xl text-center border-2 border-yellow-500">
                            <p class="text-3xl font-black text-yellow-600" id="rapor-bakim-sayisi">0</p>
                            <p class="text-sm font-bold text-gray-600">Toplam Bakım</p>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div>
                            <h4 class="text-xl font-bold text-brand-dark mb-4 border-l-4 border-brand-orange pl-3">🏍️ Motor Bazlı Bakım Özeti</h4>
                            <div id="rapor-motor-listesi" class="space-y-3"></div>
                        </div>

                        <div>
                            <h4 class="text-xl font-bold text-brand-dark mb-4 border-l-4 border-brand-yellow pl-3">👥 Kurye Performansı</h4>
                            <div id="rapor-kurye-listesi" class="space-y-3"></div>
                        </div>

                        <div>
                            <h4 class="text-xl font-bold text-brand-dark mb-4 border-l-4 border-yellow-500 pl-3">🔧 Son Bakım Kayıtları</h4>
                            <div id="rapor-son-bakimlar" class="space-y-2"></div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t-2 border-gray-200 text-center text-sm text-gray-500">
                        <p>Bu rapor MotoTakip Pro sisteminden otomatik oluşturulmuştur.</p>
                        <p class="mt-1">© 2026 - Tüm hakları saklıdır.</p>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- MODALLER -->
    <div id="modal-kurye" class="modal">
        <div class="modal-content">
            <h3 class="text-xl font-bold mb-4 text-brand-dark" id="kurye-modal-title">Yeni Kurye Ekle</h3>
            <input type="hidden" id="kurye-id">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">İsim Soyisim *</label>
                    <input type="text" id="kurye-modal-isim" class="w-full px-4 py-3 rounded-xl border-2 border-brand-yellow focus:border-brand-orange outline-none">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Telefon (İsteğe Bağlı)</label>
                    <input type="text" id="kurye-modal-telefon" class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-brand-orange outline-none" placeholder="0555 123 45 67">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Plaka *</label>
                    <input type="text" id="kurye-modal-plaka" class="w-full px-4 py-3 rounded-xl border-2 border-brand-yellow focus:border-brand-orange outline-none uppercase" placeholder="34 ABC 123">
                    <p class="text-xs text-gray-500 mt-1">* Bu plaka ile sistemde kayıtlı motor aranacaktır</p>
                </div>
            </div>
            <div class="flex space-x-3 mt-6">
                <button onclick="saveKurye()" class="flex-1 py-3 btn-primary rounded-xl font-bold">Kaydet</button>
                <button onclick="closeModal('kurye')" class="flex-1 py-3 bg-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-300">İptal</button>
            </div>
        </div>
    </div>

    <div id="modal-motor" class="modal">
        <div class="modal-content">
            <h3 class="text-xl font-bold mb-4 text-brand-dark" id="motor-modal-title">Yeni Motor Ekle</h3>
            <input type="hidden" id="motor-id">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Plaka *</label>
                    <input type="text" id="motor-modal-plaka" class="w-full px-4 py-3 rounded-xl border-2 border-brand-yellow focus:border-brand-orange outline-none uppercase">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Model *</label>
                    <input type="text" id="motor-modal-model" class="w-full px-4 py-3 rounded-xl border-2 border-brand-yellow focus:border-brand-orange outline-none">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Yıl</label>
                    <input type="number" id="motor-modal-yil" class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-brand-orange outline-none" value="2023">
                </div>
            </div>
            <div class="flex space-x-3 mt-6">
                <button onclick="saveMotor()" class="flex-1 py-3 bg-gradient-to-r from-brand-orange to-brand-darkOrange text-white rounded-xl font-bold hover:scale-105 transition-all">Kaydet</button>
                <button onclick="closeModal('motor')" class="flex-1 py-3 bg-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-300">İptal</button>
            </div>
        </div>
    </div>

    <div id="modal-motor-gecmisi" class="modal">
        <div class="modal-content max-w-2xl">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-bold text-brand-dark">📋 Motor Bakım Geçmişi</h3>
                <button onclick="closeModal('motor-gecmisi')" class="text-gray-500 hover:text-brand-orange text-2xl">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div id="motor-gecmisi-icerik" class="space-y-4 max-h-96 overflow-y-auto"></div>
        </div>
    </div>

    <script>
        let kuryeler = [];
        let motorlar = [];
        let bakimKayitlari = [];
        let currentUser = null;
        let currentRole = null;

        const BAKIM_YERLERI = ['Demir Motor', 'Altay Lastik', 'Mustafa Yuca Manavgat', 'Ataberk', 'Moto Bambam'];

        function loadData() {
            const saved = ['mototakip_kuryeler', 'mototakip_motorlar', 'mototakip_bakimlar'];
            saved.forEach((key, idx) => {
                const data = localStorage.getItem(key);
                if (data) {
                    if (idx === 0) kuryeler = JSON.parse(data);
                    if (idx === 1) motorlar = JSON.parse(data);
                    if (idx === 2) bakimKayitlari = JSON.parse(data);
                }
            });
            updateStats();
        }

        function saveData() {
            localStorage.setItem('mototakip_kuryeler', JSON.stringify(kuryeler));
            localStorage.setItem('mototakip_motorlar', JSON.stringify(motorlar));
            localStorage.setItem('mototakip_bakimlar', JSON.stringify(bakimKayitlari));
            updateStats();
        }

        function showKuryeLogin() {
            document.getElementById('kurye-form').classList.remove('hidden');
            document.getElementById('kurye-btn').classList.add('hidden');
            document.getElementById('admin-form').classList.add('hidden');
            document.getElementById('admin-btn').classList.remove('hidden');
        }

        function showAdminLogin() {
            document.getElementById('admin-form').classList.remove('hidden');
            document.getElementById('admin-btn').classList.add('hidden');
            document.getElementById('kurye-form').classList.add('hidden');
            document.getElementById('kurye-btn').classList.remove('hidden');
        }

        function loginKurye() {
            const isim = document.getElementById('kurye-isim').value.trim();
            const plaka = document.getElementById('kurye-plaka').value.trim().toUpperCase();
            const telefon = document.getElementById('kurye-telefon').value.trim();

            if (!isim || !plaka) {
                alert('İsim ve plaka zorunludur!');
                return;
            }

            // Motor kayıtlı mı kontrol et, yoksa otomatik oluştur
            let motor = motorlar.find(m => m.plaka === plaka);
            if (!motor) {
                motor = {
                    id: Date.now(),
                    plaka: plaka,
                    model: 'Bilinmiyor',
                    yil: new Date().getFullYear(),
                    km: 0,
                    olusturmaTarihi: new Date().toISOString()
                };
                motorlar.push(motor);
                saveData();
            }

            // Kurye kayıtlı mı kontrol et
            let kurye = kuryeler.find(k => k.isim === isim && k.plaka === plaka);
            if (!kurye) {
                kurye = {
                    id: Date.now(),
                    isim: isim,
                    plaka: plaka,
                    telefon: telefon,
                    durum: 'aktif',
                    ilkGiris: new Date().toISOString()
                };
                kuryeler.push(kurye);
                saveData();
            }

            currentUser = kurye;
            currentRole = 'kurye';
            
            document.getElementById('login-screen').classList.add('hidden');
            document.getElementById('kurye-panel').classList.remove('hidden');
            document.getElementById('kurye-plaka-display').textContent = plaka;
            
            updateKuryeDisplay();
        }

        function loginAdmin() {
            const user = document.getElementById('admin-user').value;
            const pass = document.getElementById('admin-pass').value;

            if (user === 'admin' && pass === 'admin123') {
                currentRole = 'admin';
                document.getElementById('login-screen').classList.add('hidden');
                document.getElementById('admin-panel').classList.remove('hidden');
                
                loadData();
                renderKuryeList();
                renderMotorList();
                renderBakimKayitlari();
                generateReport();
            } else {
                alert('Hatalı giriş!');
            }
        }

        function logout() {
            location.reload();
        }

        function updateKuryeDisplay() {
            const kurye = kuryeler.find(k => k.id === currentUser.id);
            const motor = motorlar.find(m => m.plaka === kurye.plaka);
            
            // Bu motorun yağ değişimi sayısını bul
            const yagSayisi = bakimKayitlari.filter(b => b.plaka === motor.plaka && b.tip === 'yag').length;
            const sonBakim = bakimKayitlari.filter(b => b.plaka === motor.plaka).sort((a,b) => new Date(b.tarih) - new Date(a.tarih))[0];

            let uyariHtml = '';
            if (yagSayisi > 0 && yagSayisi % 2 === 0) {
                uyariHtml = `<div class="bg-red-100 border-2 border-red-400 rounded-xl p-4 mb-4">
                    <p class="text-red-700 font-bold text-center">
                        ⚠️ DİKKAT: 2 yağ değişimi tamamlandı!<br>
                        Bir sonraki bakımda <strong>GENEL BAKIM</strong> yaptırmanız önerilir.
                    </p>
                </div>`;
            }

            document.getElementById('kurye-motor-info').innerHTML = `
                ${uyariHtml}
                <div class="bg-gradient-to-r from-brand-lightYellow to-orange-50 p-4 rounded-xl border-2 border-brand-yellow mb-4">
                    <div class="flex justify-between items-center mb-2">
                        <span class="font-bold text-brand-dark">🏍️ Plaka</span>
                        <span class="text-2xl font-black text-brand-orange">${motor.plaka}</span>
                    </div>
                    <div class="flex justify-between items-center mb-2">
                        <span class="font-bold text-brand-dark">📊 Model</span>
                        <span class="font-bold text-gray-700">${motor.model}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-brand-dark">🛢️ Yağ Değişimi</span>
                        <span class="px-3 py-1 bg-brand-yellow text-brand-dark rounded-full font-bold">${yagSayisi} kez</span>
                    </div>
                </div>
                ${sonBakim ? `
                <div class="bg-blue-50 border-l-4 border-blue-400 p-3 rounded-r-xl">
                    <p class="text-sm text-blue-800">
                        <i class="fas fa-info-circle mr-1"></i>
                        Son bakım: <strong>${new Date(sonBakim.tarih).toLocaleDateString('tr-TR')}</strong> - 
                        ${sonBakim.km.toLocaleString()} km'de ${sonBakim.tip === 'yag' ? 'yağ değişimi' : 'genel bakım'}
                    </p>
                </div>
                ` : '<p class="text-center text-gray-500 text-sm">Henüz bakım kaydı yok</p>'}
            `;
        }

        function selectBakimYeri(yer) {
            document.querySelectorAll('.bakim-yeri-btn').forEach(btn => {
                btn.classList.remove('ring-4', 'ring-brand-orange', 'bg-brand-lightYellow');
            });
            event.target.classList.add('ring-4', 'ring-brand-orange', 'bg-brand-lightYellow');
            document.getElementById('secili-bakim-yeri').value = yer;
        }

        function selectBakimTipi(tip) {
            document.getElementById('secili-bakim-tipi').value = tip;
            
            const btnYag = document.getElementById('btn-yag');
            const btnGenel = document.getElementById('btn-genel');
            
            if (tip === 'yag') {
                btnYag.className = 'flex-1 p-4 rounded-xl border-2 border-brand-yellow bg-brand-lightYellow text-brand-darkOrange font-bold transform scale-105 shadow-lg transition-all';
                btnGenel.className = 'flex-1 p-4 rounded-xl border-2 border-gray-200 text-gray-600 font-bold hover:border-brand-orange hover:bg-orange-50 transition-all';
                
                // Yağ değişimi sayısını kontrol et
                const motor = motorlar.find(m => m.plaka === currentUser.plaka);
                const yagSayisi = bakimKayitlari.filter(b => b.plaka === motor.plaka && b.tip === 'yag').length;
                
                if (yagSayisi >= 2 && yagSayisi % 2 === 0) {
                    document.getElementById('bakim-uyari').classList.remove('hidden');
                } else {
                    document.getElementById('bakim-uyari').classList.add('hidden');
                }
            } else {
                btnGenel.className = 'flex-1 p-4 rounded-xl border-2 border-brand-orange bg-orange-100 text-brand-darkOrange font-bold transform scale-105 shadow-lg transition-all';
                btnYag.className = 'flex-1 p-4 rounded-xl border-2 border-gray-200 text-gray-600 font-bold hover:border-brand-yellow hover:bg-brand-lightYellow transition-all';
                document.getElementById('bakim-uyari').classList.add('hidden');
            }
        }

        function bakimYaptir() {
            const yer = document.getElementById('secili-bakim-yeri').value;
            const tip = document.getElementById('secili-bakim-tipi').value;
            const km = parseInt(document.getElementById('bakim-km-input').value);

            if (!yer) {
                alert('Lütfen bakım yapılan yeri seçin!');
                return;
            }
            if (!km || km <= 0) {
                alert('Geçerli bir KM girin!');
                return;
            }

            const kurye = kuryeler.find(k => k.id === currentUser.id);
            const motor = motorlar.find(m => m.plaka === kurye.plaka);

            // Motor KM'sini güncelle
            motor.km = km;

            // Bakım kaydı oluştur
            const kayit = {
                id: Date.now(),
                plaka: motor.plaka,
                model: motor.model,
                tip: tip,
                km: km,
                yer: yer,
                kuryeIsim: kurye.isim,
                kuryeId: kurye.id,
                telefon: kurye.telefon,
                tarih: new Date().toISOString()
            };

            bakimKayitlari.push(kayit);
            saveData();

            // Formu temizle
            document.getElementById('bakim-km-input').value = '';
            document.querySelectorAll('.bakim-yeri-btn').forEach(btn => {
                btn.classList.remove('ring-4', 'ring-brand-orange', 'bg-brand-lightYellow');
            });
            document.getElementById('secili-bakim-yeri').value = '';

            const tipText = tip === 'yag' ? '🛢️ Yağ Değişimi' : '🔧 Genel Bakım';
            alert(`✅ ${tipText} kaydedildi!\n\n📍 ${yer}\n📊 ${km.toLocaleString()} km\n📅 ${new Date().toLocaleDateString('tr-TR')}`);
            
            updateKuryeDisplay();
        }

        function showMotorHistoryKurye() {
            const kurye = kuryeler.find(k => k.id === currentUser.id);
            showMotorHistory(kurye.plaka);
        }

        function showMotorHistory(plaka) {
            const motor = motorlar.find(m => m.plaka === plaka);
            const bakimlar = bakimKayitlari.filter(b => b.plaka === plaka).sort((a,b) => new Date(b.tarih) - new Date(a.tarih));
            
            let html = `
                <div class="bg-gradient-to-r from-brand-yellow to-brand-orange text-white p-4 rounded-xl mb-4">
                    <h4 class="font-bold text-xl">${motor.plaka}</h4>
                    <p class="text-sm opacity-90">${motor.model} - ${motor.yil}</p>
                </div>
            `;

            if (bakimlar.length === 0) {
                html += '<p class="text-center text-gray-500 py-8">Henüz bakım kaydı yok.</p>';
            } else {
                const yagSayisi = bakimlar.filter(b => b.tip === 'yag').length;
                const genelSayisi = bakimlar.filter(b => b.tip === 'genel').length;
                
                html += `
                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="bg-brand-lightYellow p-3 rounded-xl text-center">
                            <p class="text-2xl font-bold text-brand-orange">${yagSayisi}</p>
                            <p class="text-xs font-bold text-gray-600">Yağ Değişimi</p>
                        </div>
                        <div class="bg-orange-100 p-3 rounded-xl text-center">
                            <p class="text-2xl font-bold text-brand-darkOrange">${genelSayisi}</p>
                            <p class="text-xs font-bold text-gray-600">Genel Bakım</p>
                        </div>
                    </div>
                    <div class="space-y-3">
                `;

                bakimlar.forEach((b, idx) => {
                    const isYag = b.tip === 'yag';
                    const sayi = isYag ? 
                        bakimlar.filter((x, i) => i >= idx && x.tip === 'yag').length : 
                        bakimlar.filter((x, i) => i >= idx && x.tip === 'genel').length;
                    
                    html += `
                        <div class="p-4 rounded-xl border-2 ${isYag ? 'bg-yellow-50 border-brand-yellow' : 'bg-orange-50 border-brand-orange'}">
                            <div class="flex justify-between items-start mb-2">
                                <span class="px-3 py-1 rounded-full text-xs font-bold ${isYag ? 'bg-brand-yellow text-brand-dark' : 'bg-brand-orange text-white'}">
                                    ${isYag ? '🛢️ Yağ Değişimi' : '🔧 Genel Bakım'} #${sayi}
                                </span>
                                <span class="text-xs text-gray-500">${new Date(b.tarih).toLocaleDateString('tr-TR')}</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-sm">
                                <div>
                                    <p class="text-gray-500 text-xs">KM</p>
                                    <p class="font-bold text-lg">${b.km.toLocaleString()}</p>
                                </div>
                                <div>
                                    <p class="text-gray-500 text-xs">Yer</p>
                                    <p class="font-bold text-brand-orange">${b.yer}</p>
                                </div>
                            </div>
                            <div class="mt-2 pt-2 border-t border-gray-200">
                                <p class="text-xs text-gray-600">
                                    <i class="fas fa-user mr-1"></i> ${b.kuryeIsim}
                                    ${b.telefon ? `<span class="ml-2 text-brand-blue">📞 ${b.telefon}</span>` : ''}
                                </p>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
            }

            document.getElementById('motor-gecmisi-icerik').innerHTML = html;
            document.getElementById('modal-motor-gecmisi').classList.add('active');
        }

        // YÖNETİCİ FONKSİYONLARI
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
        }

        function showSection(section) {
            document.querySelectorAll('[id^="section-"]').forEach(el => el.classList.add('hidden'));
            document.getElementById(`section-${section}`).classList.remove('hidden');
            
            const titles = {
                'dashboard': '📊 Dashboard',
                'kuryeler': '👥 Kurye Yönetimi',
                'motors': '🏍️ Motor Yönetimi',
                'bakim': '🔧 Bakım Kayıtları',
                'rapor': '📄 Rapor Oluştur'
            };
            document.getElementById('page-title').textContent = titles[section];
            
            if (section === 'kuryeler') renderKuryeList();
            if (section === 'motors') renderMotorList();
            if (section === 'bakim') renderBakimKayitlari();
            if (section === 'rapor') generateReport();
        }

        function updateStats() {
            document.getElementById('stat-kurye').textContent = kuryeler.length;
            document.getElementById('stat-motor').textContent = motorlar.length;
            document.getElementById('stat-yag').textContent = bakimKayitlari.filter(b => b.tip === 'yag').length;
            document.getElementById('stat-genel').textContent = bakimKayitlari.filter(b => b.tip === 'genel').length;
        }

        function renderKuryeList() {
            const container = document.getElementById('kurye-list');
            if (kuryeler.length === 0) {
                container.innerHTML = '<div class="col-span-3 text-center py-12 text-gray-500 bg-white rounded-2xl">Henüz kurye yok.</div>';
                return;
            }

            container.innerHTML = kuryeler.map(k => {
                const bakimSayisi = bakimKayitlari.filter(b => b.kuryeId === k.id).length;
                return `
                <div class="bg-white p-6 rounded-2xl shadow-lg card-hover border-t-4 border-brand-yellow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-brand-yellow to-brand-orange rounded-full flex items-center justify-center text-white text-xl font-bold">
                            ${k.isim.charAt(0)}
                        </div>
                        <span class="px-3 py-1 bg-brand-lightYellow text-brand-darkOrange rounded-full text-xs font-bold">
                            ${bakimSayisi} bakım
                        </span>
                    </div>
                    <h4 class="font-bold text-lg text-brand-dark">${k.isim}</h4>
                    <p class="text-brand-orange font-bold mb-1">🏍️ ${k.plaka}</p>
                    ${k.telefon ? `<p class="text-gray-500 text-sm mb-3">📞 ${k.telefon}</p>` : '<p class="text-gray-400 text-sm mb-3 italic">Telefon yok</p>'}
                    <div class="flex space-x-2">
                        <button onclick="editKurye(${k.id})" class="flex-1 py-2 bg-brand-yellow text-brand-dark rounded-lg text-sm font-bold hover:bg-brand-orange hover:text-white transition-all">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button onclick="deleteKurye(${k.id})" class="flex-1 py-2 bg-red-500 text-white rounded-lg text-sm font-bold hover:bg-red-600 transition-all">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `}).join('');
        }

        function renderMotorList() {
            const container = document.getElementById('motor-list');
            if (motorlar.length === 0) {
                container.innerHTML = '<div class="col-span-3 text-center py-12 text-gray-500 bg-white rounded-2xl">Henüz motor yok.</div>';
                return;
            }

            container.innerHTML = motorlar.map(m => {
                const bakimlar = bakimKayitlari.filter(b => b.plaka === m.plaka);
                const sonBakim = bakimlar.sort((a,b) => new Date(b.tarih) - new Date(a.tarih))[0];
                const yagSayisi = bakimlar.filter(b => b.tip === 'yag').length;
                
                return `
                <div class="bg-white p-6 rounded-2xl shadow-lg card-hover border-t-4 ${yagSayisi > 0 && yagSayisi % 2 === 0 ? 'border-red-500' : 'border-brand-orange'}">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h4 class="font-bold text-lg text-brand-dark">${m.plaka}</h4>
                            <p class="text-gray-500 text-sm">${m.model} ${m.yil}</p>
                        </div>
                        <span class="text-2xl">${yagSayisi > 0 && yagSayisi % 2 === 0 ? '⚠️' : '✅'}</span>
                    </div>
                    
                    <div class="space-y-2 mb-4">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Toplam Bakım:</span>
                            <span class="font-bold text-brand-orange">${bakimlar.length}</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Yağ Değişimi:</span>
                            <span class="font-bold text-brand-yellow">${yagSayisi}</span>
                        </div>
                        ${sonBakim ? `
                        <div class="text-xs text-gray-400 mt-2 pt-2 border-t">
                            Son: ${new Date(sonBakim.tarih).toLocaleDateString('tr-TR')} - ${sonBakim.km.toLocaleString()} km
                        </div>
                        ` : ''}
                    </div>
                    
                    <div class="flex space-x-2">
                        <button onclick="showMotorHistory('${m.plaka}')" class="flex-1 py-2 bg-brand-orange text-white rounded-lg text-sm font-bold hover:bg-brand-darkOrange transition-all">
                            <i class="fas fa-eye"></i> Geçmiş
                        </button>
                        <button onclick="editMotor(${m.id})" class="flex-1 py-2 bg-brand-yellow text-brand-dark rounded-lg text-sm font-bold hover:bg-brand-orange hover:text-white transition-all">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button onclick="deleteMotor(${m.id})" class="flex-1 py-2 bg-red-500 text-white rounded-lg text-sm font-bold hover:bg-red-600 transition-all">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `}).join('');
        }

        function renderBakimKayitlari() {
            const tbody = document.getElementById('bakim-kayitlari-table');
            if (bakimKayitlari.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">Henüz bakım kaydı yok.</td></tr>';
                return;
            }

            const sirali = [...bakimKayitlari].sort((a, b) => new Date(b.tarih) - new Date(a.tarih));
            tbody.innerHTML = sirali.map(b => `
                <tr class="hover:bg-brand-lightYellow/30 transition-all">
                    <td class="px-4 py-3 text-sm font-bold text-gray-700">${new Date(b.tarih).toLocaleDateString('tr-TR')}</td>
                    <td class="px-4 py-3 font-bold text-brand-orange">${b.plaka}</td>
                    <td class="px-4 py-3">
                        <span class="px-2 py-1 rounded-full text-xs font-bold ${b.tip === 'yag' ? 'bg-brand-yellow text-brand-dark' : 'bg-brand-orange text-white'}">
                            ${b.tip === 'yag' ? '🛢️ Yağ' : '🔧 Genel'}
                        </span>
                    </td>
                    <td class="px-4 py-3 font-bold">${b.km.toLocaleString()}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">${b.yer}</td>
                    <td class="px-4 py-3 text-sm">
                        <div class="font-bold text-gray-700">${b.kuryeIsim}</div>
                        ${b.telefon ? `<div class="text-xs text-brand-blue">📞 ${b.telefon}</div>` : ''}
                    </td>
                </tr>
            `).join('');
        }

        // RAPOR OLUŞTURMA
        function generateReport() {
            document.getElementById('rapor-tarihi').textContent = new Date().toLocaleString('tr-TR');
            document.getElementById('rapor-kurye-sayisi').textContent = kuryeler.length;
            document.getElementById('rapor-motor-sayisi').textContent = motorlar.length;
            document.getElementById('rapor-bakim-sayisi').textContent = bakimKayitlari.length;

            // Motor bazlı özet
            let motorHtml = '';
            motorlar.forEach(m => {
                const bakimlar = bakimKayitlari.filter(b => b.plaka === m.plaka);
                const yag = bakimlar.filter(b => b.tip === 'yag').length;
                const genel = bakimlar.filter(b => b.tip === 'genel').length;
                const son = bakimlar.sort((a,b) => new Date(b.tarih) - new Date(a.tarih))[0];
                
                motorHtml += `
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg border-l-4 ${yag > 0 && yag % 2 === 0 ? 'border-red-500' : 'border-brand-yellow'}">
                        <div>
                            <span class="font-bold text-brand-dark">${m.plaka}</span>
                            <span class="text-sm text-gray-500 ml-2">${m.model}</span>
                        </div>
                        <div class="text-right">
                            <span class="text-xs bg-brand-yellow px-2 py-1 rounded mr-1">Yağ: ${yag}</span>
                            <span class="text-xs bg-brand-orange text-white px-2 py-1 rounded">Genel: ${genel}</span>
                            ${son ? `<div class="text-xs text-gray-500 mt-1">Son: ${new Date(son.tarih).toLocaleDateString('tr-TR')}</div>` : ''}
                        </div>
                    </div>
                `;
            });
            document.getElementById('rapor-motor-listesi').innerHTML = motorHtml || '<p class="text-gray-500">Motor yok</p>';

            // Kurye performansı
            let kuryeHtml = '';
            kuryeler.forEach(k => {
                const bakimSayisi = bakimKayitlari.filter(b => b.kuryeId === k.id).length;
                kuryeHtml += `
                    <div class="flex justify-between items-center p-3 bg-brand-lightYellow/30 rounded-lg">
                        <div>
                            <span class="font-bold text-brand-dark">${k.isim}</span>
                            ${k.telefon ? `<span class="text-sm text-gray-500 ml-2">📞 ${k.telefon}</span>` : ''}
                        </div>
                        <span class="px-3 py-1 bg-brand-orange text-white rounded-full text-sm font-bold">${bakimSayisi} bakım</span>
                    </div>
                `;
            });
            document.getElementById('rapor-kurye-listesi').innerHTML = kuryeHtml || '<p class="text-gray-500">Kurye yok</p>';

            // Son 5 bakım
            const sonBakimlar = [...bakimKayitlari].sort((a,b) => new Date(b.tarih) - new Date(a.tarih)).slice(0, 5);
            document.getElementById('rapor-son-bakimlar').innerHTML = sonBakimlar.map(b => `
                <div class="flex justify-between items-center p-2 bg-gray-50 rounded text-sm">
                    <span class="font-bold ${b.tip === 'yag' ? 'text-brand-yellow' : 'text-brand-orange'}">
                        ${b.tip === 'yag' ? '🛢️' : '🔧'} ${b.plaka}
                    </span>
                    <span class="text-gray-600">${b.kuryeIsim}</span>
                    <span class="text-gray-500">${new Date(b.tarih).toLocaleDateString('tr-TR')}</span>
                </div>
            `).join('') || '<p class="text-gray-500">Bakım kaydı yok</p>';
        }

        function printReport() {
            window.print();
        }

        // MODAL ve CRUD fonksiyonları
        function openModal(type) {
            if (type === 'kurye-ekle') {
                document.getElementById('kurye-modal-title').textContent = 'Yeni Kurye Ekle';
                document.getElementById('kurye-id').value = '';
                document.getElementById('kurye-modal-isim').value = '';
                document.getElementById('kurye-modal-telefon').value = '';
                document.getElementById('kurye-modal-plaka').value = '';
                document.getElementById('modal-kurye').classList.add('active');
            } else if (type === 'motor-ekle') {
                document.getElementById('motor-modal-title').textContent = 'Yeni Motor Ekle';
                document.getElementById('motor-id').value = '';
                document.getElementById('motor-modal-plaka').value = '';
                document.getElementById('motor-modal-model').value = '';
                document.getElementById('motor-modal-yil').value = new Date().getFullYear();
                document.getElementById('modal-motor').classList.add('active');
            }
        }

        function closeModal(type) {
            document.getElementById(`modal-${type}`).classList.remove('active');
        }

        function saveKurye() {
            const id = document.getElementById('kurye-id').value;
            const isim = document.getElementById('kurye-modal-isim').value.trim();
            const telefon = document.getElementById('kurye-modal-telefon').value.trim();
            const plaka = document.getElementById('kurye-modal-plaka').value.trim().toUpperCase();

            if (!isim || !plaka) {
                alert('İsim ve plaka zorunludur!');
                return;
            }

            // Motor yoksa otomatik oluştur
            let motor = motorlar.find(m => m.plaka === plaka);
            if (!motor) {
                motor = {
                    id: Date.now(),
                    plaka: plaka,
                    model: 'Bilinmiyor',
                    yil: new Date().getFullYear(),
                    km: 0
                };
                motorlar.push(motor);
            }

            if (id) {
                const k = kuryeler.find(x => x.id == id);
                if (k) {
                    k.isim = isim;
                    k.telefon = telefon;
                    k.plaka = plaka;
                }
            } else {
                kuryeler.push({
                    id: Date.now(),
                    isim: isim,
                    telefon: telefon,
                    plaka: plaka,
                    durum: 'aktif',
                    ilkGiris: new Date().toISOString()
                });
            }

            saveData();
            closeModal('kurye');
            renderKuryeList();
            generateReport();
        }

        function editKurye(id) {
            const k = kuryeler.find(x => x.id === id);
            if (!k) return;
            document.getElementById('kurye-modal-title').textContent = 'Kurye Düzenle';
            document.getElementById('kurye-id').value = k.id;
            document.getElementById('kurye-modal-isim').value = k.isim;
            document.getElementById('kurye-modal-telefon').value = k.telefon || '';
            document.getElementById('kurye-modal-plaka').value = k.plaka;
            document.getElementById('modal-kurye').classList.add('active');
        }

        function deleteKurye(id) {
            if (!confirm('Silmek istediğinize emin misiniz?')) return;
            kuryeler = kuryeler.filter(k => k.id !== id);
            saveData();
            renderKuryeList();
            generateReport();
        }

        function saveMotor() {
            const id = document.getElementById('motor-id').value;
            const plaka = document.getElementById('motor-modal-plaka').value.trim().toUpperCase();
            const model = document.getElementById('motor-modal-model').value.trim();
            const yil = parseInt(document.getElementById('motor-modal-yil').value) || new Date().getFullYear();

            if (!plaka || !model) {
                alert('Plaka ve model zorunludur!');
                return;
            }

            if (id) {
                const m = motorlar.find(x => x.id == id);
                if (m) {
                    m.plaka = plaka;
                    m.model = model;
                    m.yil = yil;
                }
            } else {
                motorlar.push({
                    id: Date.now(),
                    plaka: plaka,
                    model: model,
                    yil: yil,
                    km: 0
                });
            }

            saveData();
            closeModal('motor');
            renderMotorList();
            generateReport();
        }

        function editMotor(id) {
            const m = motorlar.find(x => x.id === id);
            if (!m) return;
            document.getElementById('motor-modal-title').textContent = 'Motor Düzenle';
            document.getElementById('motor-id').value = m.id;
            document.getElementById('motor-modal-plaka').value = m.plaka;
            document.getElementById('motor-modal-model').value = m.model;
            document.getElementById('motor-modal-yil').value = m.yil;
            document.getElementById('modal-motor').classList.add('active');
        }

        function deleteMotor(id) {
            if (!confirm('Bu motoru silmek istediğinize emin misiniz? Bağlı tüm bakım kayıtları da silinecek!')) return;
            
            const m = motorlar.find(x => x.id === id);
            if (m) {
                bakimKayitlari = bakimKayitlari.filter(b => b.plaka !== m.plaka);
                kuryeler.forEach(k => { if (k.plaka === m.plaka) k.plaka = ''; });
                saveData();
            }
            motorlar = motorlar.filter(x => x.id !== id);
            saveData();
            renderMotorList();
            renderKuryeList();
            generateReport();
        }

        document.addEventListener('DOMContentLoaded', loadData);
        
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('active'); });
        });
    </script>
</body>
</html>
